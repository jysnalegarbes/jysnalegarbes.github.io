---
/*
  PDF Studio (hidden like /lab/: not in the nav, noindex). A PDF editor that
  runs in the browser: scripts/pdf-tool.ts. Styles are global (prefixed
  .pdf-) because the grid cards and overlays are created by the script.
*/
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="PDF Studio — Jayson Alegarbes"
  description="Merge, reorder, rotate, sign and fill PDFs in your browser. Files never leave your device."
  noindex
>
  <section class="pdf" data-pdf>
    <header class="pdf__intro">
      <p class="pdf__crumb"><a href="/tools/">Tools</a> <span aria-hidden="true">/</span> PDF Studio</p>
      <h1 class="pdf__title"><span class="serif-italic">pdf</span> STUDIO</h1>
      <div class="pdf__text">
        <p>Merge files, reorder, rotate and remove pages, pull out the ones you need, add text, images and signatures, cover and retype small mistakes, and fill in forms.</p>
        <p class="pdf__private">Runs entirely in your browser. Your files are never uploaded.</p>
      </div>
    </header>

    <label class="pdf-drop" data-drop>
      <input type="file" accept="application/pdf,.pdf" multiple class="visually-hidden" data-file-input />
      <span class="pdf-drop__title">Drop PDFs here</span>
      <span class="pdf-drop__or">or <span class="pdf-drop__link">choose files</span></span>
    </label>

    <p class="pdf__status" role="status" aria-live="polite" data-status></p>

    <div class="pdf__workspace" data-workspace hidden>
      <div class="pdf__tools" role="toolbar" aria-label="Pages">
        <p class="pdf__count" data-count></p>
        <div class="pdf__group">
          <button type="button" data-act="select-all" data-needs="pages">Select all</button>
          <button type="button" data-act="select-none" data-needs="selection">Select none</button>
          <button type="button" data-act="rotate-selected" data-needs="selection">Rotate selected</button>
          <button type="button" data-act="delete-selected" data-needs="selection">Delete selected</button>
          <button type="button" data-act="undo" hidden>Undo delete</button>
        </div>
        <button type="button" class="pdf__clear" data-act="clear" data-needs="pages">Start over</button>
      </div>

      <ul class="pdf-grid" data-grid aria-label="Pages"></ul>

      <section class="pdf-forms" data-forms hidden aria-labelledby="pdf-forms-title">
        <h2 class="pdf-forms__title" id="pdf-forms-title"><span class="serif-italic">form</span> FIELDS</h2>
        <p class="pdf-forms__note">Filled-in values are flattened into the page when you download.</p>
        <div class="pdf-forms__list" data-forms-list></div>
      </section>

      <div class="pdf__export">
        <label class="pdf__name">
          <span>File name</span>
          <input type="text" spellcheck="false" autocomplete="off" data-output-name />
        </label>
        <label class="pdf__name pdf__compress">
          <span>Compression</span>
          <select data-compress>
            <option value="none">None</option>
            <option value="balanced">Balanced (keeps text)</option>
            <option value="strong">Strong (keeps text)</option>
            <option value="flatten">Maximum (pages become images)</option>
          </select>
        </label>
        <div class="pdf__export-actions">
          <button type="button" class="pdf-btn" data-act="download-selected" data-needs="selection">Download selected pages</button>
          <button type="button" class="pdf-btn pdf-btn--primary" data-act="download" data-needs="pages">Download PDF</button>
        </div>
      </div>
    </div>

    <p class="pdf__note">
      Need to change text that’s already in a PDF? That takes a desktop editor, such as the free{' '}
      <a href="https://github.com/SteveTheKiller/KillerPDF" target="_blank" rel="noopener">KillerPDF</a> on Windows.
      Cover boxes only hide what’s underneath: the text is still in the file, so don’t use them to remove private
      information.
    </p>
  </section>

  <dialog class="pdf-editor" data-editor aria-labelledby="pdf-ed-title">
    <div class="pdf-editor__bar">
      <p class="pdf-editor__title" id="pdf-ed-title" data-ed-title>Page</p>
      <div class="pdf-editor__nav">
        <button type="button" data-ed="prev" aria-label="Previous page">←</button>
        <button type="button" data-ed="next" aria-label="Next page">→</button>
        <button type="button" class="pdf-btn pdf-btn--primary" data-ed="done">Done</button>
      </div>
    </div>
    <div class="pdf-editor__tools" role="toolbar" aria-label="Add to the page">
      <button type="button" data-ed="text">+ Text</button>
      <button type="button" data-ed="image">+ Image</button>
      <button type="button" data-ed="sign">+ Signature</button>
      <button type="button" data-ed="cover" title="A box that hides what's under it. Hidden text is still in the file.">+ Cover</button>
      <input type="file" accept="image/*" class="visually-hidden" tabindex="-1" data-image-input />
      <div class="pdf-editor__props" data-props>
        <label>
          <span class="visually-hidden">Text size in points</span>
          <input type="number" min="4" max="400" step="1" data-prop="size" />
          <span aria-hidden="true">pt</span>
        </label>
        <label>
          <span class="visually-hidden">Font</span>
          <select data-prop="font">
            <option value="helvetica">Sans</option>
            <option value="times">Serif</option>
            <option value="courier">Mono</option>
          </select>
        </label>
        <button type="button" class="pdf-editor__bold" data-prop="bold" aria-pressed="false">B</button>
        <label class="pdf-editor__color">
          <span class="visually-hidden">Text colour</span>
          <input type="color" data-prop="color" />
        </label>
      </div>
      <div class="pdf-editor__props" data-cover-props hidden>
        <label class="pdf-editor__color">
          <span class="visually-hidden">Cover colour</span>
          <input type="color" data-cover-color />
        </label>
        <button type="button" data-ed="match">Match page</button>
        <span class="pdf-editor__hint">Hides, doesn’t delete</span>
      </div>
      <button type="button" class="pdf-editor__remove" data-ed="crop" disabled title="Crop the selected image (or double-click it)">Crop</button>
      <button type="button" data-ed="remove" disabled>Remove</button>
    </div>
    <div class="pdf-editor__stage-wrap" data-stage-wrap>
      <div class="pdf-stage" data-stage>
        <canvas class="pdf-stage__canvas"></canvas>
        <div class="pdf-stage__layer" data-layer></div>
      </div>
    </div>
  </dialog>

  <dialog class="pdf-crop" data-crop aria-labelledby="pdf-crop-title">
    <div class="pdf-crop__bar">
      <p class="pdf-crop__title" id="pdf-crop-title">Crop image</p>
      <div class="pdf-crop__ratios" role="group" aria-label="Aspect ratio">
        <button type="button" data-ratio="free" aria-pressed="true">Free</button>
        <button type="button" data-ratio="original" aria-pressed="false">Original</button>
        <button type="button" data-ratio="1" aria-pressed="false">1:1</button>
        <button type="button" data-ratio="1.3333" aria-pressed="false">4:3</button>
        <button type="button" data-ratio="1.7778" aria-pressed="false">16:9</button>
        <button type="button" data-ratio="0.8" aria-pressed="false">4:5</button>
      </div>
    </div>
    <div class="pdf-crop__stage">
      <div class="pdf-crop__frame" data-crop-frame>
        <img alt="" draggable="false" data-crop-img />
        <div class="pdf-crop__box" data-crop-box tabindex="0" role="group" aria-label="Crop area. Arrow keys move it; Shift and arrow keys resize it.">
          <span class="pdf-crop__grid" aria-hidden="true"></span>
          <span class="pdf-crop__handle" data-h="nw" aria-hidden="true"></span>
          <span class="pdf-crop__handle" data-h="ne" aria-hidden="true"></span>
          <span class="pdf-crop__handle" data-h="sw" aria-hidden="true"></span>
          <span class="pdf-crop__handle" data-h="se" aria-hidden="true"></span>
          <span class="pdf-crop__handle pdf-crop__handle--edge" data-h="n" aria-hidden="true"></span>
          <span class="pdf-crop__handle pdf-crop__handle--edge" data-h="e" aria-hidden="true"></span>
          <span class="pdf-crop__handle pdf-crop__handle--edge" data-h="s" aria-hidden="true"></span>
          <span class="pdf-crop__handle pdf-crop__handle--edge" data-h="w" aria-hidden="true"></span>
        </div>
      </div>
    </div>
    <div class="pdf-crop__actions">
      <span class="pdf-crop__size" data-crop-size></span>
      <button type="button" data-cr="reset">Reset</button>
      <button type="button" data-cr="cancel">Cancel</button>
      <button type="button" class="pdf-btn pdf-btn--primary" data-cr="apply">Apply crop</button>
    </div>
  </dialog>

  <dialog class="pdf-sign" data-sign aria-labelledby="pdf-sign-title">
    <p class="pdf-sign__title" id="pdf-sign-title">Draw your signature</p>
    <canvas class="pdf-sign__pad" data-sign-pad></canvas>
    <div class="pdf-sign__actions">
      <div class="pdf-sign__inks">
        <button type="button" data-sg="ink" data-color="#141918" aria-pressed="true" aria-label="Black ink"><span style="background:#141918"></span></button>
        <button type="button" data-sg="ink" data-color="#1d3fa8" aria-pressed="false" aria-label="Blue ink"><span style="background:#1d3fa8"></span></button>
      </div>
      <button type="button" data-sg="clear">Clear</button>
      <button type="button" data-sg="cancel">Cancel</button>
      <button type="button" class="pdf-btn pdf-btn--primary" data-sg="use">Add signature</button>
    </div>
  </dialog>
</BaseLayout>

<script>
  import { mountPdfTool } from '../../scripts/pdf-tool';

  const root = document.querySelector<HTMLElement>('[data-pdf]');
  if (root) mountPdfTool(root);
</script>

<style is:global>
  .pdf {
    --line: color-mix(in srgb, var(--black) 14%, transparent);
    --tint: color-mix(in srgb, var(--black) 6%, var(--bg));
    padding: calc(141 * var(--px)) var(--gutter) calc(160 * var(--px));
  }

  /* ---------- Intro ---------- */

  .pdf__crumb {
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--gray);
    margin-bottom: calc(18 * var(--px));
  }

  .pdf__crumb a {
    transition: color 0.2s;
  }

  .pdf__crumb a:hover {
    color: var(--black);
  }

  .pdf__title {
    font-weight: 700;
    font-size: calc(44 * var(--px));
    white-space: nowrap;
  }

  .pdf__text {
    font-size: var(--fs-sm);
    display: flex;
    flex-direction: column;
    gap: 1lh;
    max-width: calc(432 * var(--px));
    margin-top: calc(40 * var(--px));
  }

  .pdf__private {
    font-weight: 700;
  }

  /* ---------- Buttons ---------- */

  .pdf button:disabled,
  .pdf-editor button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .pdf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 20px;
    font-size: var(--fs-sm);
    font-weight: 700;
    border: 1px solid var(--black);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .pdf-btn:not(:disabled):hover {
    background: var(--black);
    color: var(--bg);
  }

  .pdf-btn--primary {
    background: var(--black);
    color: var(--bg);
  }

  .pdf-btn--primary:not(:disabled):hover {
    background: var(--green);
    border-color: var(--green);
    color: var(--black);
  }

  /* ---------- Drop zone ---------- */

  .pdf-drop {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: calc(56 * var(--px));
    min-height: calc(260 * var(--px));
    padding: 24px;
    border: 1px dashed var(--gray);
    cursor: pointer;
    text-align: center;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      min-height 0.3s;
  }

  .pdf-drop:hover,
  .pdf-drop.is-over {
    background: var(--tint);
    border-color: var(--black);
  }

  .pdf-drop:has(input:focus-visible) {
    outline: 2px solid var(--green);
    outline-offset: 4px;
  }

  .pdf-drop__title {
    font-weight: 700;
    font-size: calc(26 * var(--px));
    text-transform: uppercase;
  }

  .pdf-drop__or {
    font-size: var(--fs-sm);
    color: var(--gray);
  }

  .pdf-drop__link {
    color: var(--black);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .pdf-drop.is-compact {
    min-height: 0;
    padding: 18px;
    flex-direction: row;
    gap: 12px;
  }

  .pdf-drop.is-compact .pdf-drop__title {
    font-size: var(--fs-sm);
  }

  .pdf__status {
    min-height: 1lh;
    margin-top: 14px;
    font-size: var(--fs-sm);
  }

  .pdf.is-busy {
    cursor: progress;
  }

  /* ---------- Toolbar ---------- */

  .pdf__tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px calc(32 * var(--px));
    margin-top: calc(24 * var(--px));
    padding: calc(16 * var(--px)) 0;
    border-block: 1px solid var(--line);
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .pdf__count {
    min-width: 12ch;
  }

  .pdf__group {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
  }

  .pdf__group button,
  .pdf__clear {
    color: var(--gray);
    padding: 6px 0;
    transition: color 0.2s;
  }

  .pdf__group button:not(:disabled):hover,
  .pdf__clear:not(:disabled):hover {
    color: var(--black);
  }

  .pdf__group [data-act='undo'] {
    color: var(--black);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }

  .pdf__clear {
    margin-left: auto;
  }

  /* ---------- Page grid ---------- */

  .pdf-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(28 * var(--px)) calc(14 * var(--px));
    margin-top: calc(32 * var(--px));
  }

  .pdf-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pdf-card.is-dragging {
    opacity: 0.35;
  }

  .pdf-card[data-drop]::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--green);
  }

  .pdf-card[data-drop='before']::before {
    left: calc(-7 * var(--px) - 1px);
  }

  .pdf-card[data-drop='after']::before {
    right: calc(-7 * var(--px) - 1px);
  }

  .pdf-card__thumb {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 3 / 4;
    padding: 10px;
    background: var(--tint);
    outline: 1px solid var(--line);
    outline-offset: -1px;
    cursor: grab;
    transition: outline-color 0.2s;
  }

  .pdf-card__thumb:hover {
    outline-color: var(--black);
  }

  .pdf-card.is-selected .pdf-card__thumb {
    outline: 2px solid var(--black);
    outline-offset: -2px;
  }

  .pdf-card__thumb canvas {
    max-width: 100%;
    max-height: 100%;
    background: #fff;
    box-shadow: 0 1px 4px color-mix(in srgb, var(--black) 18%, transparent);
  }

  .pdf-card__loading {
    font-size: var(--fs-sm);
    color: var(--gray);
  }

  .pdf-card__bar {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: var(--fs-sm);
  }

  .pdf-card__check {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    cursor: pointer;
  }

  .pdf-card__check input {
    width: 15px;
    height: 15px;
    margin: 0;
    accent-color: var(--black);
  }

  .pdf-card__src {
    color: var(--gray);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pdf-card__edits {
    margin-left: auto;
    color: var(--green);
    font-weight: 700;
    white-space: nowrap;
    filter: brightness(0.75);
  }

  .pdf-card__tools {
    display: flex;
    gap: 2px;
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .pdf-card__tools button {
    min-width: 32px;
    min-height: 32px;
    padding: 0 6px;
    color: var(--gray);
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .pdf-card__tools button:not(:disabled):hover {
    color: var(--black);
    background: var(--tint);
  }

  .pdf-card__tools [data-c='edit'] {
    margin-left: auto;
    color: var(--black);
  }

  /* ---------- Forms ---------- */

  .pdf-forms {
    margin-top: calc(72 * var(--px));
    padding-top: calc(32 * var(--px));
    border-top: 1px solid var(--line);
  }

  .pdf-forms__title {
    font-weight: 700;
    font-size: calc(28 * var(--px));
  }

  .pdf-forms__note {
    margin-top: 8px;
    font-size: var(--fs-sm);
    color: var(--gray);
  }

  .pdf-forms__list {
    display: grid;
    gap: calc(32 * var(--px));
    margin-top: calc(24 * var(--px));
  }

  .pdf-form {
    margin: 0;
    padding: 0;
    border: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px 24px;
    font-size: var(--fs-sm);
  }

  .pdf-form legend {
    padding: 0;
    margin-bottom: 12px;
    font-weight: 700;
  }

  .pdf-form__row {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pdf-form__row--check {
    flex-direction: row-reverse;
    justify-content: flex-end;
    align-items: center;
    gap: 8px;
  }

  .pdf-form label {
    color: var(--gray);
    overflow-wrap: anywhere;
  }

  .pdf-form input:not([type='checkbox']),
  .pdf-form textarea,
  .pdf-form select,
  .pdf__name input {
    width: 100%;
    font: inherit;
    color: var(--black);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--gray);
    border-radius: 0;
    padding: 6px 0;
  }

  .pdf-form textarea {
    min-height: 4lh;
    resize: vertical;
  }

  .pdf-form input[type='checkbox'] {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--black);
  }

  .pdf-form :is(input, textarea, select):focus-visible,
  .pdf__compress {
    flex: 0 1 240px;
  }

  .pdf__compress select {
    width: 100%;
    font: inherit;
    color: var(--black);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--gray);
    border-radius: 0;
    padding: 6px 0;
  }

  .pdf__compress select:focus-visible,
  .pdf__name input:focus-visible {
    outline: none;
    border-bottom-color: var(--black);
  }

  /* ---------- Export ---------- */

  .pdf__export {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 16px 24px;
    margin-top: calc(56 * var(--px));
    padding-top: calc(24 * var(--px));
    border-top: 1px solid var(--line);
  }

  .pdf__name {
    flex: 1 1 240px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 420px;
    font-size: var(--fs-sm);
  }

  .pdf__name span {
    color: var(--gray);
    font-weight: 700;
  }

  .pdf__export-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-left: auto;
  }

  .pdf__note {
    margin-top: calc(72 * var(--px));
    max-width: 52ch;
    font-size: var(--fs-sm);
    color: var(--gray);
  }

  .pdf__note a {
    color: var(--black);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  /* ---------- Editor ---------- */

  .pdf-editor {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--black);
    overflow: hidden;
  }

  .pdf-editor[open] {
    display: flex;
    flex-direction: column;
  }

  .pdf-editor::backdrop {
    background: var(--bg);
  }

  .pdf-editor__bar,
  .pdf-editor__tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
    padding: 12px var(--gutter);
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .pdf-editor__bar {
    justify-content: space-between;
    border-bottom: 1px solid color-mix(in srgb, var(--black) 14%, transparent);
  }

  .pdf-editor__title {
    font-weight: 700;
  }

  .pdf-editor__nav {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .pdf-editor__nav [data-ed='prev'],
  .pdf-editor__nav [data-ed='next'] {
    min-width: 40px;
    min-height: 40px;
  }

  .pdf-editor__tools {
    border-bottom: 1px solid color-mix(in srgb, var(--black) 14%, transparent);
  }

  .pdf-editor__tools > button {
    min-height: 36px;
    transition: color 0.2s;
  }

  .pdf-editor__tools > button:not(:disabled):hover {
    color: var(--green);
    filter: brightness(0.8);
  }

  .pdf-editor__props {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-left: 18px;
    border-left: 1px solid color-mix(in srgb, var(--black) 14%, transparent);
  }

  .pdf-editor__props[hidden] {
    display: none;
  }

  .pdf-editor__props label {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 400;
  }

  .pdf-editor__props input[type='number'] {
    width: 4.5em;
  }

  .pdf-editor__props input[type='number'],
  .pdf-editor__props select {
    font: inherit;
    color: var(--black);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--gray);
    border-radius: 0;
    padding: 4px 0;
  }

  .pdf-editor__bold {
    min-width: 32px;
    min-height: 32px;
    font-weight: 900;
    color: var(--gray);
  }

  .pdf-editor__bold[aria-pressed='true'] {
    color: var(--bg);
    background: var(--black);
  }

  .pdf-editor__color input {
    width: 32px;
    height: 32px;
    padding: 0;
