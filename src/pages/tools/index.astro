---
/*
  Tools (hidden like /lab/: not in the nav, noindex). Layout: "Index" from
  lab round tools/01-tools-layout. One big row per tool; on a fine pointer
  the tool's real screenshot follows the cursor (scripts/tools-index.ts), on
  touch each row shows a thumbnail. Screenshots: src/assets/tools/,
  captured from the tools in use. Add a tool by adding an entry to `tools`.
*/
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import pdf from '../../assets/tools/pdf.png';
import compress from '../../assets/tools/compress.png';
import convert from '../../assets/tools/convert.png';
import background from '../../assets/tools/background.png';
import upscale from '../../assets/tools/upscale.png';
import mockup from '../../assets/tools/mockup.png';
import layers from '../../assets/tools/layers.png';

const tools = [
  { href: '/tools/pdf/', name: 'PDF Studio', verb: 'Edit, merge and sign PDFs', input: 'PDF', shot: pdf },
  { href: '/tools/pdf-compress/', name: 'PDF Compressor', verb: 'Shrink a PDF to send it', input: 'PDF', shot: compress },
  { href: '/tools/image/', name: 'Image Converter', verb: 'Change an image’s format or size', input: 'Image', shot: convert },
  { href: '/tools/background/', name: 'Background Remover', verb: 'Cut the subject out of a photo', input: 'Image', shot: background },
  { href: '/tools/upscale/', name: 'Image Upscaler', verb: 'Enlarge a small image with AI', input: 'Image', shot: upscale },
  { href: '/tools/mockup/', name: 'Mockup Generator', verb: 'Put a design on a screen or in print', input: 'Image', shot: mockup },
  { href: '/tools/layers/', name: 'Image to Layers', verb: 'Split a flat graphic into editable layers', input: 'Image', shot: layers },
];

const num = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout title="Tools — Jayson Alegarbes" description="Small, free tools that run in your browser." noindex>
  <section class="tools" data-tools>
    <header class="tools__intro">
      <h1 class="tools__title"><span class="serif-italic">free</span> TOOLS</h1>
      <div class="tools__text">
        <p>Small tools I built for my own work, free to use. They run in your browser, so your files stay on your device.</p>
        <p class="tools__count">{num(tools.length)} tools</p>
      </div>
    </header>

    <ul class="tools__list" data-index-list>
      {
        tools.map((t, i) => (
          <li>
            <a class="tools__row" href={t.href} data-shot={i}>
              <span class="tools__num serif-italic">{num(i + 1)}</span>
              <span class="tools__name">{t.name}</span>
              <span class="tools__verb">{t.verb}</span>
              <span class="tools__input">{t.input}</span>
              <Image class="tools__thumb" src={t.shot} alt="" widths={[160, 320]} sizes="96px" />
            </a>
          </li>
        ))
      }
    </ul>

    <figure class="tools__preview" aria-hidden="true" data-index-preview>
      {tools.map((t) => <Image src={t.shot} alt="" widths={[480, 960]} sizes="(min-width: 1024px) 23vw, 1px" />)}
    </figure>
  </section>
</BaseLayout>

<script>
  import { mountToolsIndex } from '../../scripts/tools-index';

  const root = document.querySelector<HTMLElement>('[data-tools]');
  if (root) mountToolsIndex(root);
</script>

<style>
  .tools {
    --line: color-mix(in srgb, var(--black) 14%, transparent);
    padding: calc(141 * var(--px)) var(--gutter) calc(160 * var(--px));
  }

  .tools__title {
    font-weight: 700;
    font-size: calc(44 * var(--px));
    white-space: nowrap;
  }

  .tools__text {
    font-size: var(--fs-sm);
    display: flex;
    flex-direction: column;
    gap: 1lh;
    max-width: calc(432 * var(--px));
    margin-top: calc(57 * var(--px));
  }

  .tools__count {
    font-weight: 700;
  }

  .tools__list {
    margin-top: calc(72 * var(--px));
    border-bottom: 1px solid var(--line);
  }

  .tools__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      'num name thumb'
      'num verb thumb';
    align-items: center;
    gap: 2px calc(18 * var(--px));
    padding-block: calc(22 * var(--px));
    border-top: 1px solid var(--line);
  }

  .tools__num {
    grid-area: num;
    align-self: start;
    padding-top: 4px;
    font-size: calc(22 * var(--px));
  }

  .tools__name {
    grid-area: name;
    font-weight: 700;
    font-size: calc(28 * var(--px));
    line-height: 1;
    text-transform: uppercase;
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .tools__verb {
    grid-area: verb;
    font-size: var(--fs-sm);
    color: var(--gray);
  }

  .tools__input {
    display: none;
  }

  .tools__thumb {
    grid-area: thumb;
    width: 96px;
    height: auto; /* the image's own height attribute would win over aspect-ratio */
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: left top;
    outline: 1px solid var(--line);
    outline-offset: -1px;
  }

  .tools__preview {
    display: none;
  }

  @media (min-width: 1024px) {
    .tools {
      padding-top: calc(186 * var(--px));
      padding-right: calc(259 * var(--px));
    }

    .tools__intro {
      display: grid;
      grid-template-columns: calc(531 * var(--px)) auto;
      align-items: start;
    }

    .tools__title {
      grid-column: 1 / -1;
      font-size: calc(110 * var(--px));
    }

    .tools__text {
      grid-column: 2;
      margin-top: calc(48 * var(--px));
    }
  }

  /* Desktop with a mouse: big type, the screenshot follows the cursor */
  @media (min-width: 1024px) and (pointer: fine) {
    .tools__row {
      grid-template-columns: calc(120 * var(--px)) 1fr calc(340 * var(--px)) calc(90 * var(--px));
      grid-template-areas: 'num name verb input';
      padding-block: calc(30 * var(--px));
    }

    .tools__num {
      align-self: center;
      padding-top: 0;
      font-size: calc(36 * var(--px));
    }

    .tools__name {
      font-size: calc(66 * var(--px));
      white-space: nowrap;
    }

    .tools__verb {
      font-size: var(--fs-body);
      color: var(--black);
    }

    .tools__input {
      display: block;
      grid-area: input;
      justify-self: end;
      font-size: var(--fs-sm);
      font-weight: 700;
      color: var(--gray);
    }

    .tools__thumb {
      display: none;
    }

    .tools__row:hover .tools__name,
    .tools__row:focus-visible .tools__name {
      transform: translateX(calc(24 * var(--px)));
    }

    .tools__preview {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 20;
      width: calc(440 * var(--px));
      aspect-ratio: 16 / 10;
      margin: 0;
      pointer-events: none;
      clip-path: inset(50% 50% 50% 50%);
      transition: clip-path 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
      box-shadow: 0 18px 50px color-mix(in srgb, var(--black) 22%, transparent);
    }

    .tools__preview.is-on {
      clip-path: inset(0 0 0 0);
    }

    .tools__preview :global(img) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: left top;
      opacity: 0;
    }

    .tools__preview :global(img.is-on) {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tools__name,
    .tools__preview {
      transition: none;
    }
  }
</style>
