---
/*
  Tools (hidden like /lab/: not in the nav, noindex). Every tool as a card,
  grouped. Add a tool by adding an entry to `groups`; `art` picks one of the
  small line illustrations below.
*/
import BaseLayout from '../../layouts/BaseLayout.astro';

type Art = 'pdf' | 'compress' | 'convert' | 'cutout' | 'mockup';

const groups: { name: string; tools: { href: string; name: string; summary: string; tags: string[]; art: Art }[] }[] = [
  {
    name: 'Documents',
    tools: [
      {
        href: '/tools/pdf/',
        name: 'PDF Studio',
        summary: 'Merge, reorder, rotate and split PDFs. Add text, images and signatures, cover and retype, fill in forms.',
        tags: ['Merge', 'Sign', 'Forms', 'Cover & retype'],
        art: 'pdf',
      },
      {
        href: '/tools/pdf-compress/',
        name: 'PDF Compressor',
        summary: 'Shrink PDFs to email or upload them. Keeps text sharp, or flattens pages for the smallest file.',
        tags: ['Balanced', 'Strong', 'Maximum', 'Batch'],
        art: 'compress',
      },
    ],
  },
  {
    name: 'Images',
    tools: [
      {
        href: '/tools/image/',
        name: 'Image Converter',
        summary: 'PNG, JPG, WebP, traced SVG, favicon ICO or one PDF. Resize and compress a whole batch.',
        tags: ['WebP', 'SVG trace', 'ICO', 'Batch .zip'],
        art: 'convert',
      },
      {
        href: '/tools/background/',
        name: 'Background Remover',
        summary: 'AI cut-outs of people, products and pets. Transparent, on a colour, or on a blurred backdrop.',
        tags: ['AI', 'Transparent PNG', 'Fast or HQ'],
        art: 'cutout',
      },
    ],
  },
  {
    name: 'Design',
    tools: [
      {
        href: '/tools/mockup/',
        name: 'Mockup Generator',
        summary: 'Browser, phone, laptop, business card, poster and paper mockups, with tilt, shadow and backgrounds.',
        tags: ['Screens', 'Print', '4K export'],
        art: 'mockup',
      },
    ],
  },
];

const count = groups.reduce((n, g) => n + g.tools.length, 0);
const num = (n: number) => String(n).padStart(2, '0');
let index = 0;
---

<BaseLayout title="Tools — Jayson Alegarbes" description="Small, free tools that run in your browser." noindex>
  <section class="tools">
    <header class="tools__intro">
      <h1 class="tools__title"><span class="serif-italic">free</span> TOOLS</h1>
      <div class="tools__text">
        <p>Small tools I built for my own work, free to use. They all run in your browser, so your files stay on your device.</p>
        <p class="tools__count">{num(count)} tools</p>
      </div>
    </header>

    {
      groups.map((g) => (
        <section class="tools__group" aria-label={g.name}>
          <h2 class="tools__group-name">
            <span class="serif-italic">{g.name.toLowerCase()}</span>
          </h2>
          <ul class="tools__grid">
            {g.tools.map((t) => (
              <li>
                <a class="tool-card" href={t.href}>
                  <span class="tool-card__art" aria-hidden="true">
                    {t.art === 'pdf' && (
                      <svg viewBox="0 0 120 80">
                        <rect x="34" y="10" width="40" height="54" rx="2" />
                        <rect x="46" y="16" width="40" height="54" rx="2" class="fill" />
                        <path d="M53 30h26M53 37h26M53 44h16" />
                        <path d="M55 58c4-6 7 2 10-2s5-3 8 0" class="accent" />
                      </svg>
                    )}
                    {t.art === 'compress' && (
                      <svg viewBox="0 0 120 80">
                        <rect x="42" y="14" width="36" height="52" rx="2" class="fill" />
                        <path d="M50 28h20M50 35h20M50 42h12" />
                        <path d="M24 40h12m-5-5 5 5-5 5M96 40H84m5-5-5 5 5 5" class="accent" />
                      </svg>
                    )}
                    {t.art === 'convert' && (
                      <svg viewBox="0 0 120 80">
                        <rect x="18" y="20" width="34" height="40" rx="2" />
                        <path d="M22 54l9-11 7 7 5-5 6 9" />
                        <rect x="68" y="20" width="34" height="40" rx="2" class="fill" />
                        <path d="M72 54l9-11 7 7 5-5 6 9" />
                        <path d="M55 40h10m-4-4 4 4-4 4" class="accent" />
                      </svg>
                    )}
                    {t.art === 'cutout' && (
                      <svg viewBox="0 0 120 80">
                        <rect x="30" y="12" width="60" height="58" rx="2" class="checker" />
                        <circle cx="60" cy="32" r="9" class="fill" />
                        <path d="M44 70c0-14 7-22 16-22s16 8 16 22" class="fill" />
                        <path d="M30 12h60v58H30z" class="accent dash" />
                      </svg>
                    )}
                    {t.art === 'mockup' && (
                      <svg viewBox="0 0 120 80">
                        <rect x="16" y="16" width="64" height="42" rx="3" class="fill" />
                        <path d="M16 23h64" />
                        <circle cx="21" cy="19.5" r="1.2" />
                        <circle cx="25" cy="19.5" r="1.2" />
                        <rect x="84" y="28" width="20" height="38" rx="4" class="fill" />
                        <rect x="24" y="30" width="22" height="4" class="accent-fill" />
                      </svg>
                    )}
                  </span>
                  <span class="tool-card__head">
                    <span class="tool-card__num serif-italic">{num(++index)}</span>
                    <span class="tool-card__name">{t.name}</span>
                  </span>
                  <span class="tool-card__summary">{t.summary}</span>
                  <span class="tool-card__tags">
                    {t.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </span>
                  <span class="tool-card__open">Open →</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </section>
</BaseLayout>

<style>
  .tools {
    --line: color-mix(in srgb, var(--black) 14%, transparent);
    padding: calc(141 * var(--px)) var(--gutter) calc(160 * var(--px));
  }

  .tools__title {
    font-weight: 700;
    font-size: calc(44 * var(--px));
    white-space: nowrap;
  }

  .tools__text {
    font-size: var(--fs-sm);
    display: flex;
    flex-direction: column;
    gap: 1lh;
    max-width: calc(432 * var(--px));
    margin-top: calc(57 * var(--px));
  }

  .tools__count {
    font-weight: 700;
  }

  .tools__group {
    margin-top: calc(72 * var(--px));
  }

  .tools__group-name {
    font-size: calc(32 * var(--px));
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }

  .tools__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-top: 20px;
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding: 0 0 18px;
    font-size: var(--fs-sm);
  }

  .tool-card__art {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    margin-bottom: 6px;
    background: color-mix(in srgb, var(--black) 5%, var(--bg));
    outline: 1px solid var(--line);
    outline-offset: -1px;
    transition:
      background-color 0.3s,
      outline-color 0.3s;
  }

  .tool-card__art svg {
    width: 62%;
    fill: none;
    stroke: var(--black);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .tool-card__art .fill {
    fill: var(--bg);
  }

  .tool-card__art .accent {
    stroke: var(--green);
    stroke-width: 2;
  }

  .tool-card__art .accent-fill {
    fill: var(--green);
    stroke: none;
  }

  .tool-card__art .checker {
    fill: color-mix(in srgb, var(--black) 10%, var(--bg));
    stroke: none;
  }

  .tool-card__art .dash {
    stroke-dasharray: 3 3;
  }

  .tool-card:hover .tool-card__art {
    outline-color: var(--black);
  }

  .tool-card:hover .tool-card__art svg {
    transform: scale(1.06);
  }

  .tool-card__head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .tool-card__num {
    font-size: calc(22 * var(--px));
    line-height: 1;
  }

  .tool-card__name {
    font-weight: 700;
    font-size: max(16px, calc(20 * var(--px)));
    text-transform: uppercase;
  }

  .tool-card__summary {
    max-width: 44ch;
  }

  .tool-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    color: var(--gray);
  }

  .tool-card__open {
    margin-top: auto;
    padding-top: 4px;
    font-weight: 700;
  }

  .tool-card:hover .tool-card__open {
    color: color-mix(in srgb, var(--green) 75%, var(--black));
  }

  @media (prefers-reduced-motion: reduce) {
    .tool-card__art svg {
      transition: none;
    }
  }

  @media (min-width: 640px) {
    .tools__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 20px;
    }
  }

  @media (min-width: 1024px) {
    .tools {
      padding-top: calc(186 * var(--px));
      padding-right: calc(259 * var(--px));
    }

    .tools__intro {
      display: grid;
      grid-template-columns: calc(531 * var(--px)) auto;
      align-items: start;
    }

    .tools__title {
      grid-column: 1 / -1;
      font-size: calc(110 * var(--px));
    }

    .tools__text {
      grid-column: 2;
      margin-top: calc(48 * var(--px));
    }

    .tools__group-name {
      font-size: calc(48 * var(--px));
    }

    .tools__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: calc(40 * var(--px)) calc(28 * var(--px));
    }

    .tool-card__num {
      font-size: calc(30 * var(--px));
    }
  }
</style>
