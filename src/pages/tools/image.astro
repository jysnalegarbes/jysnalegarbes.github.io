---
/*
  Image Converter (hidden like /lab/: not in the nav, noindex). Converts
  images in the browser: scripts/image-tool.ts. Styles: styles/tools.css.
*/
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/tools.css';
---

<BaseLayout
  title="Image Converter — Jayson Alegarbes"
  description="Convert images to PNG, JPG, WebP, SVG, ICO or PDF in your browser. Files never leave your device."
  noindex
>
  <section class="tool" data-img>
    <header class="tool__intro">
      <p class="tool__crumb"><a href="/tools/">Tools</a> <span aria-hidden="true">/</span> Image Converter</p>
      <h1 class="tool__title"><span class="serif-italic">image</span> CONVERTER</h1>
      <div class="tool__text">
        <p>Convert images to PNG, JPG, WebP, traced SVG, a favicon (ICO) or one PDF, plus AVIF in browsers that can write it. Resize and compress them on the way, one file or a whole batch.</p>
        <p class="tool__private">Runs entirely in your browser. Your files are never uploaded, and converting strips hidden metadata such as camera and location info.</p>
      </div>
    </header>

    <label class="tool-drop" data-drop>
      <input type="file" accept="image/*,.heic,.heif,.svg,.ico,.avif,.webp,.bmp" multiple class="visually-hidden" data-file-input />
      <span class="tool-drop__title">Drop images here</span>
      <span class="tool-drop__or">or <span class="tool-drop__link">choose files</span>, or paste a screenshot</span>
    </label>

    <p class="tool__status" role="status" aria-live="polite" data-status></p>

    <div class="tool__workspace" data-workspace hidden>
      <div class="tool-settings">
        <fieldset class="tool-settings__group">
          <legend>Convert to</legend>
          <div class="tool-formats">
            <label><input type="radio" name="format" value="webp" checked /><span>WebP</span></label>
            <label><input type="radio" name="format" value="jpeg" /><span>JPG</span></label>
            <label><input type="radio" name="format" value="png" /><span>PNG</span></label>
            <label><input type="radio" name="format" value="avif" /><span>AVIF</span></label>
            <label><input type="radio" name="format" value="svg" /><span>SVG</span></label>
            <label><input type="radio" name="format" value="ico" /><span>ICO</span></label>
            <label><input type="radio" name="format" value="pdf" /><span>PDF</span></label>
          </div>
          <p class="tool-settings__note" data-format-note></p>
        </fieldset>

        <div class="tool-settings__group" data-quality-row>
          <label class="tool-settings__label" for="tool-quality">Quality <output data-quality-out>85</output></label>
          <input id="tool-quality" type="range" min="10" max="100" step="1" value="85" data-quality />
        </div>

        <div class="tool-settings__group">
          <label class="tool-settings__label" for="tool-resize">Size</label>
          <div class="tool-resize">
            <select id="tool-resize" data-resize>
              <option value="original">Original size</option>
              <option value="width">Set width</option>
              <option value="height">Set height</option>
              <option value="percent">Scale by %</option>
            </select>
            <input type="number" min="1" max="16384" step="1" aria-label="Size value" data-resize-value hidden />
            <span data-resize-unit hidden>px</span>
          </div>
        </div>

        <div class="tool-settings__group" data-trace-row hidden>
          <label class="tool-settings__label" for="img-colors">Colours <output data-trace-colors-out>16</output></label>
          <input id="img-colors" type="range" min="2" max="64" step="1" value="16" data-trace-colors />
          <label class="tool-settings__label tool-settings__label--sub" for="img-detail">Detail</label>
          <div class="tool-resize">
            <select id="img-detail" data-trace-detail>
              <option value="low">Smooth (fewer shapes)</option>
              <option value="medium" selected>Balanced</option>
              <option value="high">Detailed</option>
            </select>
          </div>
        </div>

        <div class="tool-settings__group" data-bg-row hidden>
          <label class="tool-settings__label" for="tool-bg">Background</label>
          <input id="tool-bg" type="color" value="#ffffff" data-bg />
        </div>
      </div>

      <ul class="tool-list" data-list aria-label="Images"></ul>

      <div class="tool__export">
        <p class="tool__summary" data-summary></p>
        <div class="tool__export-actions">
          <button type="button" class="tool__clear" data-act="clear">Start over</button>
          <button type="button" class="tool-btn tool-btn--primary" data-act="download-all" disabled>Download all (.zip)</button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { mountImageTool } from '../../scripts/image-tool';

  const root = document.querySelector<HTMLElement>('[data-img]');
  if (root) mountImageTool(root);
</script>
