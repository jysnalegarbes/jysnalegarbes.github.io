---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const items = (await getCollection('in-progress', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

// The entries have no images yet. On the dev server only, stand-ins from the
// Work projects fill them so the scroll and hover effects can be judged; the
// built site keeps the plain placeholder tiles.
const standIns = import.meta.env.DEV
  ? Object.values(
      import.meta.glob<{ default: ImageMetadata }>('../assets/projects/**/*.png', { eager: true }),
    ).map((m) => m.default)
  : [];

const cards = items.map(({ data }, i) => ({
  title: data.title,
  image: data.image ?? standIns[i % Math.max(1, standIns.length)],
  alt: data.image ? data.alt : '',
}));

// Three columns, filled left to right (the order of the old grid)
const columns = [0, 1, 2].map((c) => cards.filter((_, i) => i % 3 === c));
---

<!--
  In Progress. The intro text holds still while the
  cards scroll by in an endless loop (in-progress.ts): the page itself
  doesn't scroll, each column wraps around. Drum Roll + skew on scroll,
  liquid ink on hover (in-progress-hover.ts, fine pointers);
  /in-progress/?tweak opens their panel. Settings: src/config/in-progress.json.
  Without JS it's the plain grid.
-->
<BaseLayout title="In Progress — Jayson Alegarbes" current="in-progress">
  <section class="ip" data-ip>
    <div class="ip__intro">
      <h1 class="ip__title"><span class="serif-italic">in</span> PROGRESS</h1>
      <div class="ip__text">
        <p>
          A space for ideas that are still finding their shape.<br />Experiments, visual explorations, unfinished
          thoughts, and things I simply wanted to try.
        </p>
        <p>— Not everything here needs to become a finished project.</p>
      </div>
    </div>

    <div class="ip__grid" data-ip-grid>
      {
        columns.map((col) => (
          <ul class="ip-col" data-ip-col>
            {col.map((card) => (
              <li class="ip-card" data-ip-card>
                {card.image ? (
                  <Image
                    src={card.image}
                    alt={card.alt}
                    widths={[300, 700]}
                    sizes="(min-width: 1024px) 18vw, 30vw"
                    loading="eager"
                  />
                ) : (
                  <span class="visually-hidden">{card.title}</span>
                )}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  import { mountInProgress } from '../scripts/in-progress';

  const root = document.querySelector<HTMLElement>('[data-ip]');
  if (root) mountInProgress(root);
</script>

<style>
  .ip {
    --card-w: 126;
    --card-h: 142;
    --col-gap: 7;
    --row-gap: 178;
    --stagger: 37.5;
    padding: calc(141 * var(--px)) var(--gutter) calc(120 * var(--px));
  }

  .ip__title {
    font-weight: 700;
    font-size: calc(44 * var(--px));
    white-space: nowrap;
  }

  .ip__text {
    font-size: var(--fs-sm);
    display: flex;
    flex-direction: column;
    gap: 1lh;
    max-width: calc(432 * var(--px));
    margin-top: calc(57 * var(--px));
  }

  .ip__grid {
    display: grid;
    grid-template-columns: repeat(3, calc(var(--card-w) * var(--px)));
    align-items: start;
    column-gap: calc(var(--col-gap) * var(--px));
    margin-top: calc(168 * var(--px));
  }

  .ip-col {
    display: flex;
    flex-direction: column;
    gap: calc(var(--row-gap) * var(--px));
  }

  /* First row steps up from left to right */
  .ip-col:nth-child(1) {
    margin-top: calc(var(--stagger) * 2 * var(--px));
  }

  .ip-col:nth-child(2) {
    margin-top: calc(var(--stagger) * var(--px));
  }

  .ip-card {
    position: relative;
    height: calc(var(--card-h) * var(--px));
    overflow: hidden;
    background: var(--brown);
  }

  .ip-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Live (in-progress.ts): one screen, the columns loop on their own */
  .ip:global(.is-live) {
    height: 100svh;
    overflow: hidden;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  /* The text stays over the cards passing under it, inverting over them so
     it stays readable: #f5ffff in difference mode is --black on --bg */
  .ip:global(.is-live) .ip__intro {
    position: relative;
    z-index: 2;
    color: #f5ffff;
    mix-blend-mode: difference;
  }

  :global(html:has(.ip.is-live)) {
    overflow: hidden;
    overscroll-behavior: none;
  }

  .ip:global(.is-live) .ip-col {
    position: relative;
    display: block;
  }

  .ip:global(.is-live) .ip-card {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    will-change: transform;
    backface-visibility: hidden;
  }

  /* Mobile: the cards pass under a soft edge below the text */
  @media (max-width: 1023px) {
    .ip:global(.is-live) .ip__grid {
      height: var(--ip-grid-h, auto);
      overflow: clip;
      mask-image: linear-gradient(transparent, #000 calc(40 * var(--px)));
    }
  }

  @media (min-width: 1024px) {
    .ip {
      --card-w: 344;
      --card-h: 389;
      --col-gap: 19;
      --row-gap: 98;
      --stagger: 102.5;
      display: grid;
      grid-template-columns: calc(531 * var(--px)) auto;
      align-items: start;
      padding-top: calc(186 * var(--px));
    }

    .ip__title {
      font-size: calc(110 * var(--px));
    }

    .ip__text {
      margin-top: calc(141 * var(--px));
    }

    .ip__grid {
      margin-top: calc(27 * var(--px));
    }
  }
</style>
