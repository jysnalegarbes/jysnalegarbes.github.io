---
/*
  Effects library (hidden: not in the nav, noindex). Every option round from
  lab/<project>/<page>/<round>/round.md, grouped by project and page. Rounds
  with a demo get live previews (the demo page scaled down in an iframe,
  mounted only while on screen); the rest show their code only.
*/
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const PAGE_ORDER = ['Home', 'Work', 'Case study', 'About', 'In Progress', 'Contact'];
const pageRank = (p: string) => (PAGE_ORDER.indexOf(p) + 1 || 99);

const rounds = (await getCollection('lab'))
  .map((entry) => {
    // lab/portfolio/about/06-portrait-expand/round.md → portfolio/about/06-portrait-expand
    const dir = (entry.filePath ?? '').replace(/\\/g, '/').replace(/^lab\//, '').replace(/\/round\.md$/, '');
    return { ...entry.data, dir };
  })
  .sort(
    (a, b) =>
      a.project.localeCompare(b.project) || pageRank(a.page) - pageRank(b.page) || a.order - b.order,
  );

// Project → page → rounds
const groups = new Map<string, Map<string, typeof rounds>>();
for (const r of rounds) {
  const pages = groups.get(r.project) ?? new Map();
  pages.set(r.page, [...(pages.get(r.page) ?? []), r]);
  groups.set(r.project, pages);
}

const options = rounds.flatMap((r) => r.options);
const chosen = options.filter((o) => o.status === 'chosen').length;
const pages = [...new Set(rounds.map((r) => r.page))];
const num = (n: number) => String(n).padStart(2, '0');
const date = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const statusLabel = { chosen: 'Chosen', rejected: 'Not chosen', review: 'On review' } as const;
---

<BaseLayout title="Effects Library — Jayson Alegarbes" description="Motion and interaction options explored while building." noindex>
  <section class="lab" data-lab>
    <header class="lab__intro">
      <h1 class="lab__title"><span class="serif-italic">effects</span> LIBRARY</h1>
      <div class="lab__text">
        <p>
          Every motion and interaction option explored while building my projects: the ones that shipped, and the ones
          that didn't.
        </p>
        <p class="lab__count">
          {rounds.length} rounds · {options.length} options · {chosen} chosen
        </p>
      </div>
    </header>

    <div class="lab__tools" role="toolbar" aria-label="Filter the library">
      <div class="lab__filter" data-filter="page">
        <button type="button" aria-pressed="true" data-value="">All</button>
        {pages.map((p) => <button type="button" aria-pressed="false" data-value={p}>{p}</button>)}
      </div>
      <div class="lab__filter" data-filter="status">
        <button type="button" aria-pressed="true" data-value="">Any status</button>
        <button type="button" aria-pressed="false" data-value="chosen">Chosen</button>
        <button type="button" aria-pressed="false" data-value="review">On review</button>
        <button type="button" aria-pressed="false" data-value="rejected">Not chosen</button>
      </div>
      <label class="lab__search">
        <span class="visually-hidden">Search</span>
        <input type="search" placeholder="Search effects" data-search />
      </label>
      <button type="button" class="lab__pause" aria-pressed="false" data-pause>Pause previews</button>
    </div>

    <p class="lab__empty" data-empty hidden>Nothing matches.</p>

    {
      [...groups].map(([project, byPage]) => (
        <section class="lab-project">
          <h2 class="lab-project__name">{project}</h2>
          {[...byPage].map(([page, list]) => (
            <section class="lab-page" data-page={page}>
              <h3 class="lab-page__name">
                <span class="serif-italic">{page.toLowerCase()}</span>
                <span class="lab-page__count">{num(list.length)}</span>
              </h3>
              {list.map((r) => (
                <article
                  class="lab-round"
                  data-round
                  data-search-text={`${r.title} ${r.summary}`.toLowerCase()}
                >
                  <div class="lab-round__info">
                    <p class="lab-round__num serif-italic">{num(r.order)}</p>
                    <h4 class="lab-round__title">{r.title}</h4>
                    <p class="lab-round__summary">{r.summary}</p>
                    <p class="lab-round__meta">
                      {date(r.date)}
                      {!r.demo && ' · code only, no live preview yet'}
                    </p>
                    {r.files.length > 0 && (
                      <ul class="lab-round__files">
                        {r.files.map((f) => (
                          <li>
                            <span class="lab-round__file">{f}</span>
                            <a href={`/lab/src/${r.dir}/${f}`} target="_blank" rel="noopener">
                              View
                            </a>
                            <button type="button" data-copy={`/lab/src/${r.dir}/${f}`}>
                              Copy
                            </button>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>

                  <ul class:list={['lab-round__options', !r.demo && 'lab-round__options--list']}>
                    {r.options.map((o, i) => (
                      <li
                        class="lab-card"
                        data-status={o.status}
                        data-search-text={`${o.name} ${o.note} ${o.credit ?? ''}`.toLowerCase()}
                      >
                        {r.demo && (
                          <div class="lab-card__preview">
                            <div class="lab-card__frame" data-preview={`/lab/demo/${r.demo}/?pfx=${i + 1}&embed`}></div>
                            <a
                              class="lab-card__open"
                              href={`/lab/demo/${r.demo}/?pfx=${i + 1}`}
                              target="_blank"
                              rel="noopener"
                              aria-label={`Open ${o.name} full screen`}
                            >
                              Open ↗
                            </a>
                          </div>
                        )}
                        <div class="lab-card__head">
                          <span class="lab-card__num">{num(i + 1)}</span>
                          <span class="lab-card__name">{o.name}</span>
                          <span class={`lab-card__status lab-card__status--${o.status}`}>
                            {o.status === 'chosen' && (
                              <img class="ink-exempt" src="/images/brand/star.svg" width="12" height="12" alt="" />
                            )}
                            {statusLabel[o.status]}
                          </span>
                        </div>
                        <p class="lab-card__note">{o.note}</p>
                        {o.credit && <p class="lab-card__credit">{o.credit}</p>}
                      </li>
                    ))}
                  </ul>
                </article>
              ))}
            </section>
          ))}
        </section>
      ))
    }
  </section>
</BaseLayout>

<script>
  import { mountLab } from '../../scripts/lab';

  const root = document.querySelector<HTMLElement>('[data-lab]');
  if (root) mountLab(root);
</script>

<style>
  .lab {
    padding: calc(141 * var(--px)) var(--gutter) calc(160 * var(--px));
  }

  /* ---------- Intro ---------- */

  .lab__title {
    font-weight: 700;
    font-size: calc(44 * var(--px));
    white-space: nowrap;
  }

  .lab__text {
    font-size: var(--fs-sm);
    display: flex;
    flex-direction: column;
    gap: 1lh;
    max-width: calc(432 * var(--px));
    margin-top: calc(57 * var(--px));
  }

  .lab__count {
    font-weight: 700;
  }

  /* ---------- Tools ---------- */

  .lab__tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(16 * var(--px)) calc(32 * var(--px));
    margin-top: calc(72 * var(--px));
    padding: calc(16 * var(--px)) 0;
    border-block: 1px solid color-mix(in srgb, var(--black) 14%, transparent);
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .lab__filter {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
  }

  .lab__filter button,
  .lab__pause {
    color: var(--gray);
    padding: 6px 0;
    transition: color 0.2s;
  }

  .lab__filter button:hover,
  .lab__pause:hover,
  .lab__filter button[aria-pressed='true'] {
    color: var(--black);
  }

  .lab__filter button[aria-pressed='true'] {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }

  .lab__search {
    flex: 1 1 180px;
  }

  .lab__search input {
    width: 100%;
    max-width: 320px;
    font: inherit;
    font-weight: 400;
    color: var(--black);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--gray);
    padding: 6px 0;
    border-radius: 0;
  }

  .lab__search input::placeholder {
    color: var(--gray);
  }

  .lab__search input:focus-visible {
    outline: none;
    border-bottom-color: var(--black);
  }

  .lab__pause[aria-pressed='true'] {
    color: var(--black);
  }

  .lab__empty {
    margin-top: calc(80 * var(--px));
    font-size: var(--fs-sm);
    color: var(--gray);
  }

  /* ---------- Groups ---------- */

  .lab-project {
    margin-top: calc(96 * var(--px));
  }

  .lab-project__name {
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--gray);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .lab-page {
    margin-top: calc(40 * var(--px));
  }

  .lab-page__name {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    font-size: calc(36 * var(--px));
  }

  .lab-page__count {
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--gray);
  }

  /* ---------- Round ---------- */

  .lab-round {
    display: grid;
    gap: calc(28 * var(--px));
    padding-block: calc(40 * var(--px));
    border-top: 1px solid color-mix(in srgb, var(--black) 14%, transparent);
  }

  .lab-page__name + .lab-round {
    margin-top: calc(20 * var(--px));
  }

  .lab-round__num {
    font-size: calc(28 * var(--px));
    line-height: 1;
  }

  .lab-round__title {
    margin-top: calc(10 * var(--px));
    font-weight: 700;
    font-size: calc(22 * var(--px));
    text-transform: uppercase;
  }

  .lab-round__summary {
    margin-top: calc(12 * var(--px));
    font-size: var(--fs-sm);
    max-width: 36ch;
  }

  .lab-round__meta {
    margin-top: calc(12 * var(--px));
    font-size: var(--fs-sm);
    color: var(--gray);
  }

  .lab-round__files {
    margin-top: calc(18 * var(--px));
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: var(--fs-sm);
  }

  .lab-round__files li {
    display: flex;
    gap: 12px;
    align-items: baseline;
  }

  .lab-round__file {
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.92em;
    margin-right: auto;
    overflow-wrap: anywhere;
  }

  .lab-round__files a,
  .lab-round__files button {
    font-weight: 700;
    color: var(--gray);
    transition: color 0.2s;
  }

  .lab-round__files a:hover,
  .lab-round__files button:hover {
    color: var(--black);
  }

  .lab-round__options {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(36 * var(--px)) calc(19 * var(--px));
  }

  /* ---------- Option card ---------- */

  .lab-card__preview {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg);
    outline: 1px solid color-mix(in srgb, var(--black) 14%, transparent);
    outline-offset: -1px;
  }

  .lab-card__frame {
    position: absolute;
    inset: 0;
  }

  .lab-card__frame :global(iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 1440px;
    height: 900px;
    border: 0;
    transform: scale(var(--s, 0.3));
    transform-origin: 0 0;
    pointer-events: none;
  }

  /* The whole preview is the link; the label shows on hover / focus */
  .lab-card__open {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: end;
    justify-content: end;
    padding: 10px 12px;
    font-size: var(--fs-sm);
    font-weight: 700;
    color: transparent;
    transition: color 0.25s;
  }

  .lab-card__open:hover,
  .lab-card__open:focus-visible {
    color: var(--white);
  }

  .lab-card__open:focus-visible {
    outline-offset: -2px;
  }

  /* Code-only rounds: a compact list, no preview frames */
  .lab-round__options--list {
    row-gap: 0;
  }

  .lab-round__options--list .lab-card {
    padding-block: 4px 18px;
  }

  .lab-round__options--list .lab-card__head {
    margin-top: 0;
  }

  .lab-card__head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 14px;
    font-size: var(--fs-sm);
  }

  .lab-card__num {
    color: var(--gray);
    font-weight: 700;
  }

  .lab-card__name {
    font-weight: 700;
    font-size: max(15px, calc(18 * var(--px)));
  }

  .lab-card__status {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    font-weight: 700;
    color: var(--gray);
  }

  .lab-card__status--chosen {
    color: var(--black);
  }

  .lab-card__status--review::before {
    content: '';
    width: 7px;
    height: 7px;
    border: 1px solid currentColor;
    border-radius: 50%;
  }

  .lab-card__status--review {
    color: var(--black);
  }

  .lab-card__note {
    margin-top: 8px;
    font-size: var(--fs-sm);
    max-width: 52ch;
  }

  .lab-card__credit {
    margin-top: 6px;
    font-size: var(--fs-sm);
    color: var(--gray);
    font-style: italic;
  }

  .lab-card[data-status='rejected'] .lab-card__name {
    color: color-mix(in srgb, var(--black) 75%, var(--bg));
  }

  [hidden] {
    display: none !important;
  }

  /* ---------- Desktop ---------- */

  @media (min-width: 1024px) {
    /* Content ends where In Progress's grid does (x 1661), clear of the nav */
    .lab {
      padding-top: calc(186 * var(--px));
      padding-right: calc(259 * var(--px));
    }

    .lab__intro {
      display: grid;
      grid-template-columns: calc(531 * var(--px)) auto;
      align-items: start;
    }

    .lab__title {
      grid-column: 1 / -1;
      font-size: calc(110 * var(--px));
    }

    .lab__text {
      grid-column: 2;
      margin-top: calc(48 * var(--px));
    }

    .lab-page__name {
      font-size: calc(56 * var(--px));
    }

    .lab-round {
      grid-template-columns: calc(531 * var(--px)) auto;
      gap: 0;
      padding-block: calc(56 * var(--px));
    }

    .lab-round__info {
      padding-right: calc(60 * var(--px));
    }

    .lab-round__num {
      font-size: calc(44 * var(--px));
    }

    .lab-round__title {
      font-size: calc(30 * var(--px));
    }

    .lab-round__options {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
