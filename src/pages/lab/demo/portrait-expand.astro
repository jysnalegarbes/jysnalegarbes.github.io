---
/*
  Demo: About portrait-expand options (lab/portfolio/about/06-portrait-expand).
  The About opening with the library's frozen copy of the scripts; ?pfx=0..4
  picks the effect. Full page: scroll it. Embedded: it scrolls itself through
  the growth and back, and pauses on the library's message.
*/
import { Image } from 'astro:assets';
import LabDemo from '../../../layouts/LabDemo.astro';
import portrait from '../../../assets/about/portrait-hero.webp';
---

<LabDemo title="Portrait expand">
  <section class="about-intro" data-about-intro>
    <div class="about-intro__stage" data-about-stage>
      <div class="about-intro__media" data-about-media>
        <Image
          src={portrait}
          alt="Illustrated portrait of Jayson at his desk"
          width={2880}
          widths={[720, 1080, 1440, 1920, 2880]}
          sizes="max(100vw, 75vh)"
          loading="eager"
          class="about-intro__img"
        />
      </div>
      <h1 class="about-intro__greeting">
        <span class="about-intro__half" data-about-half="left"><span class="serif-italic">hi!</span> NICE TO</span>{' '}<span class="about-intro__half" data-about-half="right">MEET YOU</span>
      </h1>
      <canvas class="about-intro__wipe" data-about-wipe aria-hidden="true"></canvas>
      <div class="about-intro__black" data-about-black aria-hidden="true"></div>
    </div>
  </section>
  <div class="demo-tail"></div>
</LabDemo>

<script>
  import { mountAboutIntro } from '../../../../lab/portfolio/about/06-portrait-expand/about-intro';
  import { autoplayScroll } from '../../../scripts/lab-demo';

  const intro = document.querySelector<HTMLElement>('[data-about-intro]');
  if (intro) {
    mountAboutIntro(intro);
    // Embedded: from the closed greeting to just past full screen, and back
    autoplayScroll(() => {
      const run = intro.offsetHeight - innerHeight;
      return [run * 0.02, run * 0.68];
    });
  }
</script>

<style>
  .about-intro {
    position: relative;
    height: 100svh;
  }

  .about-intro.is-scrub {
    height: 450svh;
  }

  .about-intro__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  .about-intro__greeting {
    position: absolute;
    top: 50%;
    left: 50%;
    font-weight: 700;
    font-size: calc(40 * var(--px));
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }

  .about-intro__half {
    display: inline-block;
    will-change: transform;
  }

  .about-intro__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    overflow: hidden;
    visibility: hidden;
    will-change: transform, width, height;
  }

  .about-intro__img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .about-intro__wipe,
  .about-intro__black {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    visibility: hidden;
    pointer-events: none;
  }

  .about-intro__black {
    background: var(--black);
  }

  .demo-tail {
    height: 100svh;
    background: var(--black);
  }

  @media (min-width: 1024px) {
    .about-intro__greeting {
      top: calc(50% + 72 * var(--px));
      font-size: calc(110 * var(--px));
    }
  }
</style>
