---
import '@fontsource-variable/archivo';
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '../styles/global.css';
import SiteHeader, { type NavKey } from '../components/SiteHeader.astro';
import PageTransition from '../components/PageTransition.astro';

interface Props {
  title: string;
  description?: string;
  current?: NavKey;
  pageClass?: string;
  /** Keep the page out of search engines (the hidden /lab/ pages) */
  noindex?: boolean;
}

const {
  title,
  description = 'Jayson Alegarbes — independent UI/UX and visual designer based in Davao City, Philippines.',
  current,
  pageClass,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/images/brand/logo-mark.svg" />
    <title>{title}</title>
    <!-- Arriving through a page transition: its screen goes up before first
         paint (scripts/page-transition.ts takes it from there) -->
    <script is:inline>
      (function () {
        try {
          var raw = sessionStorage.getItem('page-transition');
          sessionStorage.removeItem('page-transition');
          var a = raw && JSON.parse(raw);
          var path = location.pathname.replace(/\/?$/, '/');
          if (a && Date.now() - a.t < 8000 && a.path.replace(/\/?$/, '/') === path) {
            document.documentElement.classList.add('pt-arriving');
            document.documentElement.setAttribute('data-pt', a.key);
          }
        } catch (e) {}
        // Only the transition's hand-over uses the view transition
        addEventListener('pagereveal', function (e) {
          if (e.viewTransition && !document.documentElement.classList.contains('pt-arriving')) e.viewTransition.skipTransition();
        });
      })();
    </script>
  </head>
  <body class={pageClass}>
    <SiteHeader current={current} />
    <main>
      <slot />
    </main>
    <PageTransition />
  </body>
</html>
