---
export type NavKey = 'work' | 'about' | 'in-progress' | 'contact';

interface Props {
  current?: NavKey;
}

const { current } = Astro.props;

const links: { key: NavKey; label: string; href: string }[] = [
  { key: 'work', label: 'Work', href: '/work/' },
  { key: 'about', label: 'About', href: '/about/' },
  { key: 'in-progress', label: 'In Progress', href: '/in-progress/' },
  { key: 'contact', label: 'Contact', href: '/contact/' },
];
---

<!--
  Rendered twice. "main" is the real header; off the home page it inverts
  against whatever scrolls under it (mix-blend-mode: difference). Brand
  green must never invert, so the green pieces are hidden there and drawn
  by "accents": an identical, unblended, inert copy showing only the
  .ink-exempt parts, kept in sync (hover, active, badge bump) by the
  script below. Same markup and CSS, so the two always line up.
-->
{
  (['main', 'accents'] as const).map((layer) => {
    const main = layer === 'main';
    const Root = main ? 'header' : 'div';
    const Brand = main ? 'a' : 'span';
    const Nav = main ? 'nav' : 'div';
    return (
      <Root
        class:list={['site-header', `site-header--${layer}`]}
        data-header={layer}
        aria-hidden={main ? undefined : 'true'}
        inert={!main}
      >
        <div class="badge desktop-only" data-badge="desktop">
          <span class="badge__icon" aria-hidden="true">
            <span class="badge__lottie badge__hands" data-badge-hands />
            <span class="badge__lottie ink-exempt" data-badge-lines />
          </span>
          <p class="badge__text">
            Open for selected
            <br />
            projects
          </p>
        </div>

        <Brand class="brand" href={main ? '/' : undefined} aria-label={main ? 'Jayson Alegarbes, home' : undefined}>
          <img class="brand__mark ink-exempt" src="/images/brand/logo-mark.svg" width="46" height="46" alt="" />
          <img class="brand__wordmark" src="/images/brand/logo-wordmark.svg" width="87" height="40" alt="" />
        </Brand>

        <Nav class="menu" aria-label={main ? 'Primary' : undefined} data-menu>
          <p class="menu__title desktop-only" aria-hidden="true">
            Menu
          </p>
          <button
            class="menu__title menu__toggle mobile-only"
            type="button"
            aria-expanded={main ? 'false' : undefined}
            aria-controls={main ? 'menu-panel' : undefined}
            data-menu-toggle
          >
            <span data-menu-label>Menu</span>
          </button>

          <div class="menu__panel" id={main ? 'menu-panel' : undefined}>
            <ul class="menu__list">
              {links.map(({ key, label, href }) => {
                const active = key === current;
                return (
                  <li>
                    <a
                      class:list={['menu__link', { 'is-active': active }]}
                      href={href}
                      aria-current={main && active ? 'page' : undefined}
                      data-nav-link={main ? '' : undefined}
                    >
                      <span class="menu__pin ink-exempt" aria-hidden="true">
                        <img class="menu__star menu__star--active" src="/images/brand/star.svg" width="18" height="18" alt="" />
                      </span>
                      <span class="menu__label">
                        <span class="menu__text">{label}</span>
                        <span class="menu__text menu__text--alt" aria-hidden="true">
                          {label}
                        </span>
                      </span>
                      <img class="menu__star menu__star--hover ink-exempt" src="/images/brand/star.svg" width="18" height="18" alt="" />
                    </a>
                  </li>
                );
              })}
            </ul>

            {/* Mobile menu: availability badge pinned bottom-left (Figma 1:1143) */}
            <div class="badge badge--panel mobile-only" data-badge="panel" data-badge-autoplay>
              <span class="badge__icon" aria-hidden="true">
                <span class="badge__lottie badge__hands" data-badge-hands />
                <span class="badge__lottie ink-exempt" data-badge-lines />
              </span>
              <p class="badge__text">
                Open for selected
                <br />
                projects
              </p>
            </div>
          </div>
        </Nav>
      </Root>
    );
  })
}

<script>
  import lottie from 'lottie-web/build/player/lottie_light';
  import fistBump from '../assets/lottie/fist-bump.json';
  import { mountNavHover } from '../scripts/nav-hover';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  /*
    Availability badges: the fist bump plays once per trigger (hover on the
    desktop badge, menu open for the mobile one). Leaving mid-way lets it
    finish so the hands never snap back. Frame 0 doubles as the rest pose,
    and the motion settles by frame 130. Each plays as two synced layers:
    the hands (which invert under the home ink like the rest of the page)
    and the green burst lines (ink-exempt).
  */
  type Anim = ReturnType<typeof lottie.loadAnimation>;

  const layersOnly = (prefix: string) => ({
    ...fistBump,
    layers: fistBump.layers.filter((layer) => layer.nm.startsWith(prefix)),
  });

  // Both header layers carry each badge (same data-badge key); they bump together
  const badges = [...document.querySelectorAll<HTMLElement>('[data-badge]')].map((badge) => {
    let anims: Anim[] = [];
    let playing = false;

    const mount = () => {
      if (anims.length || !badge.getClientRects().length) return;
      const hands = badge.querySelector<HTMLElement>('[data-badge-hands]')!;
      const lines = badge.querySelector<HTMLElement>('[data-badge-lines]')!;
      anims = (
        [
          [hands, layersOnly('hand')],
          [lines, layersOnly('lines')],
        ] as const
      ).map(([container, animationData]) =>
        lottie.loadAnimation({ container, renderer: 'svg', loop: false, autoplay: false, animationData }),
      );
      anims.forEach((a) => a.goToAndStop(0, true));
      anims[0].addEventListener('complete', () => {
        playing = false;
        anims.forEach((a) => a.goToAndStop(0, true));
      });
    };

    const play = () => {
      mount();
      if (!anims.length || playing || reducedMotion.matches) return;
      playing = true;
      anims.forEach((a) => a.playSegments([0, 130], true));
    };

    return { badge, key: badge.dataset.badge, mount, play };
  });
  const playBadge = (key: string) => badges.forEach((b) => b.key === key && b.play());
  badges.forEach(({ badge, key }) => {
    if (key && !badge.hasAttribute('data-badge-autoplay') && !badge.closest('[inert]')) {
      badge.addEventListener('mouseenter', () => playBadge(key));
    }
  });

  const mountVisibleBadges = () => badges.forEach((b) => b.mount());
  mountVisibleBadges();
  window.matchMedia('(min-width: 1024px)').addEventListener('change', mountVisibleBadges);

  // The accents copy mirrors the real nav's hover / focus / active states
  const realLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-header="main"] .menu__link')];
  const twinLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-header="accents"] .menu__link')];
  realLinks.forEach((link, i) => {
    const twin = twinLinks[i];
    if (!twin) return;
    const hover = (on: boolean) => twin.classList.toggle('is-hover', on);
    link.addEventListener('mouseenter', () => hover(true));
    link.addEventListener('mouseleave', () => hover(false));
    link.addEventListener('focus', () => hover(link.matches(':focus-visible')));
    link.addEventListener('blur', () => hover(false));
    new MutationObserver(() => twin.classList.toggle('is-active', link.classList.contains('is-active'))).observe(link, {
      attributes: true,
      attributeFilter: ['class'],
    });
  });

  // Mobile menu
  const menu = document.querySelector<HTMLElement>('[data-header="main"] [data-menu]');
  const toggle = menu?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const label = menu?.querySelector<HTMLElement>('[data-menu-label]');

  const setOpen = (open: boolean) => {
    if (!menu || !toggle || !label) return;
    menu.toggleAttribute('data-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = open ? 'Close' : 'Menu';
    document.documentElement.style.overflow = open ? 'hidden' : '';
    // Bump once the panel has faded in
    if (open) setTimeout(() => playBadge('panel'), 250);
  };

  toggle?.addEventListener('click', () => setOpen(!menu?.hasAttribute('data-open')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.hasAttribute('data-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', () => setOpen(false));

  if (menu) mountNavHover(menu);
</script>

<style>
  /* Fixed on every page: badge, logo and menu stay put while scrolling */
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    padding: calc(24 * var(--px)) var(--gutter) 0;
    pointer-events: none;
  }

  .site-header > * {
    pointer-events: auto;
  }

  /*
    Inversion off the home page. Difference blending against the page:
    colours are chosen so that over the page background (#E1E8E8) they
    land exactly on the design colours (#141918 text, #7B7F7B gray), and
    turn light over dark images. Not while the mobile menu is open (its
    panel is opaque), and not on the home page, which inverts through its
    own ink canvases.
  */
  .site-header {
    color: var(--hd-ink, var(--black));
  }

  :global(body:not(.has-ink)) .site-header--main:not(:has(.menu[data-open])) {
    --hd-ink: #cdcfd0;
    --hd-muted: #66696d;
    /* Black artwork (wordmark, hands) → #CFCACB, i.e. #141918 on the page */
    --hd-art: invert(1) brightness(0.88);
    mix-blend-mode: difference;
  }

  /* Over a fully dark page (About's text sections, set by the page script):
     the dark-frame colours exactly, without blending */
  :global(body.is-header-dark:not(.has-ink)) .site-header--main:not(:has(.menu[data-open])) {
    --hd-ink: var(--white);
    --hd-muted: var(--gray);
    /* Black artwork → light, close to #D7DEDE */
    --hd-art: invert(1) brightness(0.9);
    mix-blend-mode: normal;
  }

  /* Green never inverts: hidden in the blended header, drawn by accents */
  :global(body:not(.has-ink)) .site-header--main:not(:has(.menu[data-open])) .ink-exempt {
    visibility: hidden;
  }

  .site-header--accents {
    z-index: 21;
    visibility: hidden;
  }

  .site-header--accents,
  .site-header--accents > * {
    pointer-events: none;
  }

  .site-header--accents .ink-exempt {
    visibility: visible;
  }

  :global(body.has-ink) .site-header--accents,
  .site-header--main:has(.menu[data-open]) + .site-header--accents {
    display: none;
  }

  .brand__wordmark,
  .badge__hands {
    filter: var(--hd-art, none);
  }

  /* On ink pages the header must not form a stacking context, or it would
     trap its green .ink-exempt pieces under the fluid. Fixed positioning
     always forms one, so the (single-screen) home keeps it absolute, and
     keeps its content from covering the header instead (see index.astro). */
  :global(body.has-ink) .site-header {
    position: absolute;
    z-index: auto;
  }

  /* Availability badge */
  .badge {
    display: flex;
    align-items: stretch;
    gap: calc(20 * var(--px));
    justify-self: start;
    font-size: var(--fs-sm);
  }

  /* The box frames the rest pose; the 500×500 Lottie canvas overflows it
     so the hands can swing outward during the bump. */
  .badge__icon {
    position: relative;
    height: 2lh;
    aspect-ratio: 30 / 24;
  }

  .badge__lottie {
    position: absolute;
    top: -33.33%;
    left: -16.67%;
    width: 133.33%;
    height: 166.67%;
    pointer-events: none;
  }

  .badge__text {
    font-weight: 700;
  }

  /* Logo: mark + wordmark lockup (46 : 87 wide, 46 : 40.2 tall) */
  .brand {
    --logo-h: calc(22 * var(--px));
    grid-column: 2;
    display: flex;
    align-items: center;
    gap: calc(var(--logo-h) * 10 / 46);
  }

  .brand__mark {
    width: var(--logo-h);
    height: var(--logo-h);
  }

  .brand__wordmark {
    width: calc(var(--logo-h) * 87.003 / 46);
    height: calc(var(--logo-h) * 40.205 / 46);
  }

  /* Menu */
  .menu {
    grid-column: 3;
    justify-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: calc(151 * var(--px));
  }

  .menu__title {
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--hd-muted, var(--gray));
    text-align: right;
  }

  /* Desktop: the panel is just a pass-through wrapper */
  .menu__panel {
    display: contents;
  }

  .menu__list {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: calc(20 * var(--px));
  }

  /*
    Nav link. Default: label only. Active (current page, or just clicked):
    a green star pins to the left of the label, which stays right-aligned.
    Hover / keyboard focus (same on the active link, whose left star hands
    over): the label shifts left and a star takes the right edge. On
    hover the label cross-fades into a copy through a gooey ink filter
    (after Codrops Gooey Text Hover, demo 2); the filter and its blur
    pulse are driven from nav-hover.ts.
  */
  .menu__link {
    --star: max(13px, calc(18 * var(--px)));
    --gap: calc(10 * var(--px));
    --shift: calc(var(--star) + var(--gap));
    position: relative;
    display: flex;
    align-items: center;
    font-weight: 800;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .menu__label {
    display: grid;
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .menu__text {
    grid-area: 1 / 1;
    text-align: right;
    transition:
      opacity 0.8s cubic-bezier(0.45, 0, 0.55, 1),
      transform 0.8s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .menu__text--alt {
    opacity: 0;
    transform: translateX(0.4em);
  }

  .menu__star {
    position: absolute;
    top: 50%;
    right: 0;
    width: var(--star);
    height: var(--star);
    margin-top: calc(var(--star) / -2);
    opacity: 0;
    transform: scale(0);
    transition:
      opacity 0.5s ease 0.15s,
      transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s;
  }

  /* Zero-width slot before the label holding the active star, so the label
     stays right-aligned. It is ink-exempt itself because its hover shift
     (a transform) would otherwise trap the green star under the ink. */
  .menu__pin {
    position: relative;
    align-self: stretch;
    width: 0;
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .menu__star--active {
    right: var(--gap);
    max-width: none;
  }

  .menu__link.is-active .menu__star--active {
    opacity: 1;
    transform: none;
  }

  /* Hovering the active link hands its star over to the right edge, so
     hover looks the same on every link */
  .menu__link.is-active:is(:hover, :focus-visible, .is-hover) .menu__star--active {
    opacity: 0;
    transform: scale(0);
    transition:
      opacity 0.3s ease,
      transform 0.4s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .menu__link:is(:hover, :focus-visible, .is-hover) :is(.menu__label, .menu__pin) {
    transform: translateX(calc(-1 * var(--shift)));
  }

  .menu__link:is(:hover, :focus-visible, .is-hover) .menu__text:not(.menu__text--alt) {
    opacity: 0;
    transform: translateX(-0.4em);
  }

  .menu__link:is(:hover, :focus-visible, .is-hover) .menu__text--alt {
    opacity: 1;
    transform: none;
  }

  .menu__link:is(:hover, :focus-visible, .is-hover) .menu__star--hover {
    opacity: 1;
    transform: none;
  }

  /* Mobile: Menu opens a full-screen panel (Figma 1:1143) */
  @media (max-width: 1023.98px) {
    .site-header {
      grid-template-columns: auto 1fr auto;
    }

    .brand {
      grid-column: 1;
    }

    .menu {
      position: relative;
      z-index: 2;
    }

    /* Open menu sits above everything, including the portrait and the ink;
       the logo rides on top of the panel */
    .menu[data-open] {
      z-index: 45;
    }

    .site-header:has(.menu[data-open]) .brand {
      position: relative;
      z-index: 46;
    }

    .menu__panel {
      position: fixed;
      inset: 0;
      z-index: -1;
      display: block;
      padding: calc(148 * var(--px)) var(--gutter) calc(24 * var(--px));
      background: var(--bg);
      visibility: hidden;
      opacity: 0;
      transition:
        opacity 0.35s ease,
        visibility 0s linear 0.35s;
    }

    .menu[data-open] .menu__panel {
      visibility: visible;
      opacity: 1;
      transition: opacity 0.35s ease;
    }

    .menu__list {
      font-size: calc(20 * var(--px));
    }

    /* Accents only matter while the menu is closed (blended header) */
    .site-header--accents .menu__panel {
      display: none;
    }

    .badge--panel {
      position: absolute;
      bottom: calc(24 * var(--px));
      left: var(--gutter);
      gap: calc(12 * var(--px));
      font-size: calc(16 * var(--px));
    }
  }

  @media (min-width: 1024px) {
    .site-header {
      padding-top: calc(40 * var(--px));
    }

    /* Logo matches the availability badge's height (two lines of small text) */
    .brand {
      --logo-h: 2lh;
      font-size: var(--fs-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu__panel,
    .menu__label,
    .menu__pin,
    .menu__text,
    .menu__star {
      transition: none !important;
    }
  }
</style>
