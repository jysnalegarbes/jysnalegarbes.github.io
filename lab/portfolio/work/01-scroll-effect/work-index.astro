---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const first = projects[0];
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<BaseLayout title="Work — Jayson Alegarbes" current="work">
  <section class="work" data-work-stage>
    <h1 class="visually-hidden">Selected work</h1>

    <div class="work__scroller" data-work-scroller>
      <ol class="work__track">
        {
          projects.map((project, i) => (
            <li
              class:list={['work-item', { 'is-active': i === 0, 'is-current': i === 0 }]}
              data-work-item
              data-index={num(i)}
              data-year={project.data.year}
              data-title={project.data.title}
              data-category={project.data.category}
            >
              <a
                href={`/work/${project.id}/`}
                class="work-item__link"
                draggable="false"
                aria-label={`${num(i)} ${project.data.title}, ${project.data.category}, ${project.data.year}`}
              >
                <div class="work-item__head" aria-hidden="true">
                  <span class="work-item__index serif-italic" data-field-src="index">{num(i)}</span>
                  <span class="work-item__year" data-field-src="year">{project.data.year}</span>
                </div>
                <div class="work-item__media" data-work-media>
                  <Image
                    src={project.data.cover}
                    alt={project.data.coverAlt}
                    widths={[480, 800, 1200, 1600]}
                    sizes="(min-width: 1024px) 39vw, 90vw"
                    loading={i < 2 ? 'eager' : 'lazy'}
                    draggable="false"
                  />
                </div>
                <div class="work-item__caption" aria-hidden="true">
                  <h2 class="work-item__title" data-field-src="title">{project.data.title}</h2>
                  <p class="work-item__category" data-field-src="category">{project.data.category}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Main-slot details: fixed in place, roll to the project that settles there -->
    {
      first && (
        <div class="work__details" data-work-details aria-hidden="true">
          <span class="work-detail work-item__index serif-italic" data-field="index">
            <span class="work-detail__text">{num(0)}</span>
          </span>
          <span class="work-detail work-item__year" data-field="year" data-align-end>
            <span class="work-detail__text">{first.data.year}</span>
          </span>
          <span class="work-detail work-item__title" data-field="title">
            <span class="work-detail__text">{first.data.title}</span>
          </span>
          <span class="work-detail work-item__category" data-field="category" data-align-end>
            <span class="work-detail__text">{first.data.category}</span>
          </span>
        </div>
      )
    }

    <canvas class="work__gl" data-work-gl aria-hidden="true"></canvas>

    <p class="work__intro">
      A selection of digital experiences,<br />visual identities, and interfaces I've designed.
    </p>

    <!-- Effect preview switcher (dev, or any URL with ?fx=) -->
    <div class="fx-switch" data-fx-switch hidden>
      <span class="fx-switch__label">Scroll effect</span>
    </div>
  </section>
</BaseLayout>

<script>
  import { mountWorkGallery } from '../../scripts/work-gallery';
  import type { WorkGl, WorkFx } from '../../scripts/work-gl';

  const root = document.querySelector<HTMLElement>('[data-work-stage]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const params = new URLSearchParams(location.search);
  const fxParam = Number(params.get('fx'));
  let fx = ([1, 2, 3, 4].includes(fxParam) ? fxParam : 1) as WorkFx;
  let glLayer: WorkGl | null = null;

  if (root) {
    const gallery = mountWorkGallery(root, {
      reducedMotion,
      onFrame: (frame) => glLayer?.render(frame),
    });

    const canvas = root.querySelector<HTMLCanvasElement>('[data-work-gl]');
    const medias = [...root.querySelectorAll<HTMLElement>('[data-work-media]')];

    if (gallery && canvas && !reducedMotion) {
      import('../../scripts/work-gl').then(({ mountWorkGl, WORK_FX }) => {
        try {
          glLayer = mountWorkGl(
            canvas,
            medias.map((m) => m.querySelector('img')!),
            { fx, onReady: (i) => medias[i].classList.add('is-gl') },
          );
        } catch (err) {
          console.warn('Work WebGL disabled:', err);
          glLayer = null;
        }
        if (!glLayer) return;
        gallery.wake();

        // Preview switcher
        const box = root.querySelector<HTMLElement>('[data-fx-switch]');
        if (!box || !(import.meta.env.DEV || params.has('fx'))) return;
        box.hidden = false;
        (Object.entries(WORK_FX) as [string, string][]).forEach(([id, name]) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = `${id} ${name}`;
          btn.setAttribute('aria-pressed', String(Number(id) === fx));
          btn.addEventListener('click', () => {
            fx = Number(id) as WorkFx;
            glLayer?.setFx(fx);
            box.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
            const url = new URL(location.href);
            url.searchParams.set('fx', id);
            history.replaceState(null, '', url);
          });
          box.append(btn);
        });
      });
    }
  }
</script>

<style>
  .work {
    --active-w: 392;
    --active-h: 260;
    --item-w: 279;
    --item-h: 233;
    --step: 350;
    --gap: 24;
    position: relative;
    min-height: 100svh;
    padding-top: calc(157 * var(--px));
    padding-bottom: calc(80 * var(--px));
  }

  .work__scroller {
    overflow-x: auto;
    scrollbar-width: none;
  }

  .work__scroller::-webkit-scrollbar {
    display: none;
  }

  .work__track {
    display: flex;
    align-items: flex-start;
    gap: calc(var(--gap) * var(--px));
    width: max-content;
    padding-inline: var(--gutter);
  }

  .work-item {
    width: calc(var(--item-w) * var(--px));
    margin-top: calc(var(--step) * var(--px));
  }

  .work-item.is-active {
    width: calc(var(--active-w) * var(--px));
    margin-top: 0;
  }

  /* Mobile snapshot: the next project peeks in, overlapping the active column */
  .work-item.is-active + .work-item {
    margin-left: calc(-83 * var(--px));
  }

  .work-item__link {
    display: block;
  }

  .work-item__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: calc(10 * var(--px));
    margin-bottom: calc(24 * var(--px));
    opacity: 0;
  }

  .work-item__index {
    font-size: calc(80 * var(--px));
    line-height: 0.95;
  }

  .work-item__year {
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .work-item__media {
    height: calc(var(--item-h) * var(--px));
    overflow: hidden;
  }

  .is-active .work-item__media {
    height: calc(var(--active-h) * var(--px));
  }

  .work-item__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-item__caption {
    font-size: var(--fs-sm);
    display: flex;
    justify-content: space-between;
    gap: calc(10 * var(--px));
    margin-top: calc(24 * var(--px));
    font-weight: 700;
    opacity: 0;
  }

  .work-item__category {
    color: var(--gray);
    text-align: right;
  }

  .is-active .work-item__head,
  .is-active .work-item__caption {
    opacity: 1;
  }

  .work__intro {
    font-size: var(--fs-sm);
    position: absolute;
    bottom: calc(24 * var(--px));
    left: var(--gutter);
  }

  /*
    Live gallery (JS): one fixed screen. Cards are placed absolutely by
    work-gallery.ts along the measured rest slots; the per-card head and
    caption give way to the fixed main-slot details.
  */
  .work__details,
  .work__gl {
    display: none;
  }

  .work:global(.is-live) {
    height: 100svh;
    overflow: hidden;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  :global(html:has(.work.is-live)) {
    overflow: hidden;
    overscroll-behavior: none;
  }

  .work:global(.is-live) .work__scroller {
    overflow: visible;
  }

  .work:global(.is-live) .work-item {
    position: absolute;
    top: 0;
    left: 0;
    width: auto;
    /* Beats the staggered rest margins below */
    margin: 0 !important;
    will-change: transform;
  }

  .work:global(.is-live) .work-item__head,
  .work:global(.is-live) .work-item__caption {
    display: none;
  }

  .work:global(.is-live) .work-item:not(:global(.is-current)) .work-item__link {
    cursor: pointer;
  }

  .work:global(.is-dragging) .work-item__link {
    cursor: grabbing !important;
  }

  .work-item__media:global(.is-gl) img {
    opacity: 0;
  }

  .work__gl {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .work:global(.is-live) .work__gl {
    display: block;
  }

  .work:global(.is-live) .work__details {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .work-detail {
    position: absolute;
    display: grid;
    white-space: nowrap;
    /* Clip the roll vertically only, so italic overhang isn't cut */
    clip-path: inset(0 -40% 0 -40%);
  }

  .work-detail[data-align-end] {
    translate: -100% 0;
    justify-items: end;
  }

  .work-detail__text {
    grid-area: 1 / 1;
  }

  .work-detail.work-item__title,
  .work-detail.work-item__category {
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  /* Preview switcher */
  .fx-switch {
    position: fixed;
    right: var(--gutter);
    bottom: calc(24 * var(--px));
    z-index: 50;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    padding: 6px;
    border-radius: 999px;
    background: var(--black);
    color: var(--white);
    font-size: 12px;
    font-weight: 700;
  }

  .fx-switch[hidden] {
    display: none;
  }

  .fx-switch__label {
    padding-inline: 8px 4px;
    color: var(--gray);
  }

  .fx-switch :global(button) {
    padding: 6px 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .fx-switch :global(button[aria-pressed='true']) {
    background: var(--green);
    color: var(--black);
  }

  @media (min-width: 1024px) {
    .work {
      --active-w: 736;
      --active-h: 488;
      --item-w: 432;
      --item-h: 360;
      --step: 128;
      padding-top: calc(182 * var(--px));
      padding-bottom: calc(140 * var(--px));
    }

    .work-item.is-active + .work-item {
      margin-left: 0;
    }

    .work-item.is-active + .work-item ~ .work-item {
      margin-top: calc(256 * var(--px));
    }

    .work-item__head {
      height: calc(114 * var(--px));
      padding-block: calc(10 * var(--px));
      margin-bottom: 0;
    }

    .work__intro {
      bottom: calc(60 * var(--px));
    }

    .fx-switch {
      bottom: calc(60 * var(--px));
    }
  }

  @media (max-width: 1023.98px) {
    .fx-switch {
      bottom: auto;
      top: calc(110 * var(--px));
      left: var(--gutter);
      right: auto;
    }
  }
</style>
