---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageProgress from '../components/PageProgress.astro';
import portrait from '../assets/about/portrait-hero.webp';
import aquarium from '../assets/about/beyond-aquarium.png';
import billiards from '../assets/about/beyond-billiards.png';
import hiking from '../assets/about/beyond-hiking.jpg';
// Placeholders from the old site's Approach images (Jayson, 2026-10-26)
import serviceWeb from '../assets/about/services/web-ui-ux.webp';
import serviceVisual from '../assets/about/services/visual-design.webp';
import serviceBrand from '../assets/about/services/brand-digital.webp';

const services = await Promise.all(
  [
    { title: 'Web & UI/UX', text: 'Websites, interfaces, responsive experiences, and prototypes.', image: serviceWeb },
    { title: 'Visual Design', text: 'Digital visuals, editorial layouts, and creative direction.', image: serviceVisual },
    { title: 'Brand & Digital', text: 'Visual identities, brand systems, and digital applications.', image: serviceBrand },
  ].map(async (s) => ({
    ...s,
    // Hover image (service-hover.ts): ~46% of the screen height, so 800 wide covers 2x screens
    hover: (await getImage({ src: s.image, width: 800, format: 'webp' })).src,
  })),
);

// In the order their words come up in the text (rotations from Figma 1:711)
const photos = [
  { src: hiking, alt: 'Hiking a forest trail with friends', rot: -2.23, trigger: 'hiking' },
  { src: billiards, alt: 'Playing billiards in an open-air pool hall', rot: 0, trigger: 'billiards' },
  { src: aquarium, alt: 'A planted aquarium glowing under a lamp', rot: -4.62, trigger: 'aquariums' },
];
---

<BaseLayout title="About — Jayson Alegarbes" current="about">
  <!--
    Opening sequence (Figma 66:95): the greeting splits, the portrait opens
    between the halves and grows to fill the screen, then a noise wipe turns
    it to black from the bottom up. Without JS it stays the static greeting
    (1:142).
  -->
  <section class="about-intro" data-about-intro>
    <div class="about-intro__stage" data-about-stage>
      <div class="about-intro__media" data-about-media>
        <Image
          src={portrait}
          alt="Illustrated portrait of Jayson at his desk"
          width={2880}
          widths={[720, 1080, 1440, 1920, 2880]}
          sizes="max(100vw, 75vh)"
          loading="eager"
          class="about-intro__img"
        />
      </div>
      <h1 class="about-intro__greeting">
        <span class="about-intro__half" data-about-half="left"><span class="serif-italic">hi!</span> NICE TO</span>{' '}<span class="about-intro__half" data-about-half="right">MEET YOU</span>
      </h1>
      <canvas class="about-intro__wipe" data-about-wipe aria-hidden="true"></canvas>
      <div class="about-intro__black" data-about-black aria-hidden="true"></div>
    </div>
  </section>

  <!--
    Text sections (Figma 1:384 → 1:711; transitions 67:107, sequence 92:43):
    all five share one pinned screen and swap in place, the text never
    scrolls (about-sections.ts). Per section: data-len / data-rest = screens
    until its exit / of empty breather after it; per block: data-cue =
    screens in before it appears, data-fx = its intro.
    Desktop places everything on the Figma coordinates of a 1920×1080 frame;
    mobile stacks it. Without JS they're plain stacked screens.
  -->
  <div class="about-story" data-about-story>
    <div class="about-story__stage" data-about-stage-story>
      <!-- Ink in water behind the text (about-ink.ts) -->
      <canvas class="about-ink" data-about-ink aria-hidden="true"></canvas>
      <section class="about-sec about-sec--hello" data-about-section data-len="1.7" data-rest="1">
        <div class="about-sec__frame">
          <p class="about-hello" data-fx="goo-1" data-cue="0.5">
            Independent <span class="serif-italic">designer</span><br />based in the Philippines.
          </p>
        </div>
      </section>

      <section class="about-sec about-sec--intro" data-about-section data-len="2">
        <div class="about-sec__frame">
          <p class="about-intro-text" data-fx="scrub-lines" data-span="1.2">
            I design <span class="serif-italic">websites</span>, <span class="serif-italic">interfaces</span>, and <span
              class="serif-italic">visual experiences</span
            > that bring structure to ideas and make digital experiences easier to understand, use, and remember.
          </p>
        </div>
      </section>

      <section class="about-sec about-sec--services" data-about-section data-len="2.6">
        <div class="about-sec__frame">
          <h2 class="about-heading" data-fx="goo-2"><span class="serif-italic">what</span> I DO</h2>
          <ul class="about-services">
            {
              services.map((s, i) => (
                <li class="about-service" data-fx="stack" data-cue={0.7 + i * 0.5} data-span="0.5" data-service-img={s.hover}>
                  <h3 class="about-service__title">{s.title}</h3>
                  <p class="about-service__text">{s.text}</p>
                </li>
              ))
            }
          </ul>
          {/* Hidden for now (Jayson, 2026-10-24); its intro was words-rise at data-cue 2.3
          <p class="about-body about-services__note" data-fx="words-rise" data-cue="2.3">
            A little bit of everything. Mostly the things that look good on a screen.
          </p>
          */}
        </div>
      </section>

      <section class="about-sec about-sec--approach" data-about-section data-len="1.8">
        <div class="about-sec__frame">
          <h2 class="about-heading" data-fx="goo-2"><span class="serif-italic">my</span> APPROACH</h2>
          <div class="about-approach">
            <p class="about-body" data-fx="cascade-chars" data-cue="0.7">
              I start by understanding what needs to be communicated before worrying about how it should look. Because
              making something <span class="serif-italic">pretty is easy</span>. Making something <span
                class="serif-italic">make sense is a little more interesting</span
              >.
            </p>
            <p class="about-body" data-fx="cascade-chars" data-cue="0.7" data-fx-at="0.6">
              I balance thoughtful UX with intentional visual design, creating experiences that feel <span
                class="serif-italic">purposeful</span
              >, <span class="serif-italic">distinct</span>, and <span class="serif-italic">right</span> for the project.
            </p>
          </div>
        </div>
      </section>

      <section class="about-sec about-sec--beyond" data-about-section data-len="3" data-no-exit>
        <div class="about-sec__frame">
          <h2 class="about-heading" data-fx="goo-2"><span class="serif-italic">beyond</span> DESIGN</h2>
          <div class="about-photos" data-photos>
            {
              photos.map((p) => (
                <div class="about-photo" data-photo-trigger={p.trigger} data-rot={p.rot} style={`--rot: ${p.rot}deg`}>
                  <Image
                    src={p.src}
                    alt={p.alt}
                    widths={[420, 864]}
                    sizes="(min-width: 1024px) 20vw, 46vw"
                    class="about-photo__img"
                  />
                </div>
              ))
            }
          </div>
          <p class="about-body about-beyond__text" data-fx="goo-2" data-cue="0.7" data-highlight>
            Outside design, I enjoy exploring new trails through hiking. I challenge friends to a game of billiards
            whenever I get the chance. I also spend an unreasonable amount of time admiring aquariums on Reels. I don't
            have one yet, but apparently watching other people's tanks counts as research.
          </p>
        </div>
      </section>

      <!--
        Endings on review (about-end.ts, ?end=1|2|3): the page keeps one.
        1 and 3 are one more screen in the story; 2 follows the story.
      -->
      <section class="about-sec about-sec--end" data-about-section data-len="1.6" data-no-exit data-end="1">
        <div class="about-sec__frame">
          <h2 class="about-heading" data-fx="goo-2"><span class="serif-italic">what's</span> NEXT</h2>
          <ul class="about-end-links">
            <li data-fx="goo-1" data-cue="0.45">
              <a class="about-end-link" href="/work/"><span>SEE <span class="serif-italic">the</span> WORK</span><span class="about-end-link__arrow" aria-hidden="true">→</span></a>
            </li>
            <li data-fx="goo-1" data-cue="0.45" data-fx-at="0.25">
              <a class="about-end-link" href="/contact/"><span>SAY <span class="serif-italic">hello</span></span><span class="about-end-link__arrow" aria-hidden="true">→</span></a>
            </li>
          </ul>
        </div>
      </section>

      <section class="about-sec about-sec--next" data-about-section data-len="2" data-no-exit data-end="3">
        <div class="about-sec__frame">
          <a class="about-next" href="/work/" data-fx="goo-1" data-cue="0.3">
            <span class="about-next__label serif-italic">next</span>
            <span class="about-next__title">WORK</span>
          </a>
          <div class="about-next__track" data-fx="goo-1" data-cue="0.3" aria-hidden="true">
            <span class="about-next__bar" data-end-bar></span>
          </div>
          <p class="about-next__hint label" data-fx="goo-1" data-cue="0.5" aria-hidden="true">Keep scrolling</p>
        </div>
      </section>
    </div>
  </div>

  <section class="about-end" data-end="2">
    <div class="about-end__inner" data-end-inner>
      <p class="about-end__lead">Thanks for reading.</p>
      <h2 class="about-end__title">GOT <span class="serif-italic">a project</span><br /> IN MIND?</h2>
      <ul class="about-end__links">
        <li><a class="about-end__link" href="/contact/">Say hello <span aria-hidden="true">→</span></a></li>
        <li><a class="about-end__link" href="/work/">See the work <span aria-hidden="true">→</span></a></li>
      </ul>
    </div>
  </section>

  <PageProgress
    chapters={['Hello', 'Independent', 'Introduction', 'What I do', 'My approach', 'Beyond design', "What's next"]}
  />
</BaseLayout>

<script>
  import { mountAboutIntro } from '../scripts/about-intro';
  import { mountAboutSections } from '../scripts/about-sections';
  import { mountPageProgress } from '../scripts/page-progress';
  import { mountServiceHover } from '../scripts/service-hover';
  import { mountAboutInk, INK_DEFAULTS, INK_OPTIONS, type InkOption } from '../scripts/about-ink';
  import { pickAboutEnd, mountAboutEnd, type EndVariant } from '../scripts/about-end';
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';

  // Options on review: ?ink=a|b|c|off, ?end=1|2|3 (defaults: C and 1)
  const params = new URLSearchParams(location.search);
  const inkParam = params.get('ink');
  const inkOption: InkOption = inkParam === 'off' || (inkParam && inkParam in INK_OPTIONS) ? (inkParam as InkOption) : 'c';
  const endParam = Number(params.get('end'));
  const endVariant = ([1, 2, 3].includes(endParam) ? endParam : 1) as EndVariant;
  pickAboutEnd(endVariant); // before the sections engine reads the page

  const intro = document.querySelector<HTMLElement>('[data-about-intro]');
  if (intro) mountAboutIntro(intro);
  const story = document.querySelector<HTMLElement>('[data-about-story]');
  // The ink listens for section changes, so it goes in first
  const inkCanvas = document.querySelector<HTMLCanvasElement>('[data-about-ink]');
  const ink =
    story && inkCanvas && inkOption !== 'off'
      ? mountAboutInk(inkCanvas, story, { ...INK_DEFAULTS, ...INK_OPTIONS[inkOption] })
      : null;
  const sections = story ? mountAboutSections(story) : null;

  // Chapters: the opening, then each text section (and the curtain ending)
  const progress = document.querySelector<HTMLElement>('[data-pp]');
  const curtain = document.querySelector<HTMLElement>('[data-end="2"]');
  if (progress) {
    mountPageProgress(progress, () => [
      0,
      ...(sections?.starts() ?? []),
      ...(curtain ? [curtain.getBoundingClientRect().top + window.scrollY] : []),
    ]);
  }

  mountAboutEnd(endVariant, ink, () => sections?.starts().at(-1) ?? 0);

  // what I DO: hover a service to show its image (the ink dims meanwhile)
  const servicesSec = document.querySelector<HTMLElement>('.about-sec--services');
  if (servicesSec) {
    const items = [...servicesSec.querySelectorAll<HTMLElement>('[data-service-img]')];
    mountServiceHover(servicesSec, items.map((el) => ({ el, src: el.dataset.serviceImg! })));
    items.forEach((el) => {
      el.addEventListener('pointerenter', () => ink?.quiet(true));
      el.addEventListener('pointerleave', () => ink?.quiet(false));
    });
  }

  if (import.meta.env.DEV && params.has('review')) {
    import('../scripts/about-review').then(({ mountAboutReview }) => mountAboutReview(ink, inkOption, endVariant));
  }

  // Smooth scrolling (brief 67:107), paused while the open menu holds the page
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const lenis = new Lenis({ autoRaf: true });
    const menu = document.querySelector('[data-header="main"] [data-menu]');
    if (menu) {
      new MutationObserver(() => (menu.hasAttribute('data-open') ? lenis.stop() : lenis.start())).observe(menu, {
        attributes: true,
        attributeFilter: ['data-open'],
      });
    }
  }
</script>

<style>
  /* ---------- Opening ---------- */

  .about-intro {
    position: relative;
    height: 100svh;
  }

  /* Pinned for the length of the sequence (set by the script) */
  .about-intro.is-scrub {
    height: 450svh;
  }

  .about-intro__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  .about-intro__greeting {
    position: absolute;
    top: 50%;
    left: 50%;
    font-weight: 700;
    font-size: calc(40 * var(--px));
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }

  .about-intro__half {
    display: inline-block;
    will-change: transform;
  }

  .about-intro__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    overflow: hidden;
    visibility: hidden;
    will-change: transform, width, height;
  }

  .about-intro__img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .about-intro__wipe,
  .about-intro__black {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    visibility: hidden;
    pointer-events: none;
  }

  .about-intro__black {
    background: var(--black);
  }

  /* ---------- Text sections ---------- */

  /* Without JS: plain stacked screens */
  .about-story {
    background: var(--black);
    color: var(--white);
  }

  .about-sec {
    position: relative;
    height: 100svh;
    overflow: hidden;
  }

  /* With JS: one pinned stage, the sections layered on it */
  .about-story.is-story {
    height: calc((var(--story-len) + 1) * 100svh);
  }

  /* Overlaps the opening's last screen so the stage pins right as the wipe
     ends; that screen stays clear so the wipe shows through */
  .about-intro.is-scrub + .about-story.is-story {
    margin-top: -100svh;
    background: linear-gradient(transparent 100svh, var(--black) 100svh);
  }

  .is-story .about-story__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  .is-story .about-sec {
    position: absolute;
    inset: 0;
    height: auto;
    pointer-events: none;
  }

  .is-story .about-sec.is-active {
    pointer-events: auto;
  }

  .is-story [data-fx],
  .is-story [data-photo-trigger] {
    opacity: 0;
  }

  /* The goo slide and ink-bleed scale, kept apart from each block's own transform */
  [data-fx] {
    translate: var(--fx-x, 0px) 0;
    scale: var(--fx-s, 1);
  }

  .is-story [data-highlight] {
    color: rgb(255 255 255 / 0.15);
  }

  /* Mobile: content stacked and centred under the header */
  .about-sec__frame {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: calc(32 * var(--px));
    height: 100%;
    padding: calc(110 * var(--px)) var(--gutter) calc(48 * var(--px));
  }

  .about-hello,
  .about-intro-text,
  .about-body,
  .about-service__text {
    font-weight: 400;
  }

  .about-hello {
    font-size: calc(32 * var(--px));
    text-align: center;
  }

  .about-intro-text {
    font-size: calc(26 * var(--px));
    text-indent: 3.76em;
  }

  /* Split pieces are inline-blocks: they'd each inherit the paragraph indent */
  .about-sec :global(.split-word),
  .about-sec :global(.split-char) {
    text-indent: 0;
  }

  /* Split lines (and their masks) are blocks: only the first keeps the paragraph indent */
  .about-sec :global(.split-line-mask:not(:first-child)),
  .about-sec :global(.split-line:not(:first-child)) {
    text-indent: 0;
  }

  .about-heading {
    font-weight: 700;
    font-size: calc(48 * var(--px));
    white-space: nowrap;
  }

  .about-body {
    font-size: calc(20 * var(--px));
    text-indent: 3.76em;
  }

  /* Hover image canvas (service-hover.ts) behind the services text */
  .about-sec--services :global(.service-hover) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .about-sec--services .about-sec__frame {
    position: relative;
    z-index: 1;
  }

  .about-services {
    display: flex;
    flex-direction: column;
    gap: calc(28 * var(--px));
  }

  .about-service {
    display: flex;
    flex-direction: column;
    gap: calc(12 * var(--px));
  }

  .about-service__title {
    font-weight: 700;
    font-size: calc(22 * var(--px));
    text-transform: uppercase;
  }

  .about-service__text {
    font-size: calc(14 * var(--px));
  }

  .about-approach {
    display: flex;
    flex-direction: column;
    gap: calc(32 * var(--px));
  }

  .about-photos {
    position: relative;
    flex: none;
    width: calc(200 * var(--px));
    height: calc(235 * var(--px));
    margin-inline: auto;
  }

  .about-photo {
    position: absolute;
    inset: 0;
    transform: rotate(var(--rot));
  }

  .about-photo__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Desktop: Figma coordinates on a 1920×1080 frame, top-aligned with the
     header so the columns line up with the nav (e.g. services at 213) */
  @media (min-width: 1024px) {
    .about-intro__greeting {
      top: calc(50% + 72 * var(--px));
      font-size: calc(110 * var(--px));
    }

    .about-sec__frame {
      display: block;
      position: relative;
      height: calc(1080 * var(--px));
      padding: 0;
    }

    .about-sec__frame > * {
      position: absolute;
    }

    /* 1:384 — bottom edge at 50% + 87 */
    .about-hello {
      top: calc(627 * var(--px));
      left: 50%;
      font-size: calc(80 * var(--px));
      white-space: nowrap;
      transform: translate(-50%, -100%);
    }

    /* 1:556 */
    .about-intro-text {
      top: 50%;
      left: calc(307 * var(--px));
      width: calc(1306 * var(--px));
      font-size: calc(70 * var(--px));
      transform: translateY(-50%);
    }

    /* 1:603 / 1:661 — centred on y 286.5 */
    .about-heading {
      top: calc(286.5 * var(--px));
      left: var(--gutter);
      font-size: calc(110 * var(--px));
      transform: translateY(-50%);
    }

    .about-body {
      font-size: calc(40 * var(--px));
    }

    .about-services {
      top: calc(213 * var(--px));
      left: calc(820 * var(--px));
      width: calc(860 * var(--px));
      padding-block: calc(10 * var(--px));
      gap: calc(80 * var(--px));
    }

    .about-service {
      gap: calc(40 * var(--px));
    }

    .about-service__title {
      font-size: calc(40 * var(--px));
    }

    .about-service__text {
      font-size: var(--fs-body);
    }

    /* bottom edge at 75% + 150 */
    .about-services__note {
      top: calc(960 * var(--px));
      left: calc(820 * var(--px));
      width: calc(888 * var(--px));
      transform: translateY(-100%);
    }

    .about-approach {
      top: calc(382 * var(--px));
      left: calc(820 * var(--px));
      width: calc(888 * var(--px));
      gap: calc(80 * var(--px));
    }

    /* 93:417 (updated 2026-10-26) — all three photos share one 385.6×453.4
       box at (209.85, 423), each turned by its own --rot */
    .about-photos {
      top: calc(423 * var(--px));
      left: calc(209.85 * var(--px));
      width: calc(385.58 * var(--px));
      height: calc(453.42 * var(--px));
      margin: 0;
    }

    .about-beyond__text {
      top: calc(408 * var(--px));
      left: calc(820 * var(--px));
      width: calc(888 * var(--px));
    }
  }

  /* ---------- Ink (about-ink.ts) ---------- */

  .about-ink {
    display: none;
  }

  /* First in the stage, so the sections paint over it */
  .is-story .about-ink {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* ---------- Endings on review (about-end.ts) ---------- */

  /* Without JS the page keeps ending 1 (a plain last screen) */
  :global(html:not([data-about-end])) [data-end]:not([data-end='1']) {
    display: none;
  }

  /* 1 · Last word: two big links */
  /* Rules on the links, not the list, so they come in with them */
  .about-end-links {
    display: flex;
    flex-direction: column;
  }

  .about-end-links li:last-child .about-end-link {
    border-bottom: 1px solid rgb(255 255 255 / 0.18);
  }

  .about-end-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5em;
    padding-block: calc(18 * var(--px));
    border-top: 1px solid rgb(255 255 255 / 0.18);
    font-weight: 700;
    font-size: calc(32 * var(--px));
    color: inherit;
    text-decoration: none;
    transition: color 0.35s ease;
  }

  .about-end-link__arrow {
    font-weight: 400;
    transition: translate 0.45s cubic-bezier(0.625, 0.05, 0, 1);
  }

  .about-end-link:hover,
  .about-end-link:focus-visible {
    color: var(--green);
  }

  .about-end-link:hover .about-end-link__arrow,
  .about-end-link:focus-visible .about-end-link__arrow {
    translate: 0.25em 0;
  }

  /* 3 · Next page: a big link and a line that fills toward it */
  .about-sec--next .about-sec__frame {
    align-items: center;
  }

  .about-next {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .about-next__label {
    font-size: calc(32 * var(--px));
  }

  .about-next__title {
    font-weight: 700;
    font-size: calc(96 * var(--px));
    line-height: 1;
    transition: color 0.35s ease;
  }

  .about-next:hover .about-next__title,
  .about-next:focus-visible .about-next__title {
    color: var(--green);
  }

  .about-next__track {
    width: calc(200 * var(--px));
    height: 2px;
    background: rgb(255 255 255 / 0.18);
  }

  .about-next__bar {
